---
import { Image } from 'astro:assets';
import postcard from '../assets/img/calmon-postcard-background.png';
import leaves from '../assets/img/calmon-feedback-leaves.png';
---
<div class="calmon-feedback-art" aria-hidden="true">
  <Image class="postcard-base" src={postcard} width={1600} format="webp" alt="" loading="lazy" />
  <div class="postcard-leaf-frame">
    <Image class="feedback-leaves" src={leaves} width={720} height={720} format="webp" alt="" loading="lazy" />
  </div>
</div>
<script>
  import { observeIllustrationMotion } from '../scripts/calmon-illustration-motion';
  observeIllustrationMotion('.calmon-feedback-art');
</script>
<style>
  .calmon-feedback-art{position:absolute;inset:0;pointer-events:none}
  :global(html[dir=rtl]) .calmon-feedback-art{transform:scaleX(-1)}
  .postcard-base{display:block;width:100%;height:100%;object-fit:cover;object-position:right top}
  .postcard-leaf-frame{position:absolute;left:0;bottom:-12px;width:140px;height:124px;overflow:hidden;opacity:.45}
  .calmon-feedback-art .feedback-leaves{position:absolute;left:-60px;top:-335px;width:600px;height:600px;max-width:none;transform-origin:17.2% 74.2%}
  .calmon-feedback-art.is-active .feedback-leaves{animation:postcard-leaf-breeze 5.5s ease-in-out infinite}
  @keyframes postcard-leaf-breeze{0%,12%,100%{transform:rotate(0)}30%{transform:rotate(-6deg)}52%{transform:rotate(4deg)}72%{transform:rotate(-3deg)}88%{transform:rotate(2deg)}}
  @media(max-width:600px){.postcard-base{opacity:.4}.postcard-leaf-frame{opacity:.5}}
  @media(prefers-reduced-motion:reduce){.calmon-feedback-art .feedback-leaves{animation:none!important}}
</style>
