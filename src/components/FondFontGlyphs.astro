---
const { specimen, x = 0, y = 0, width = 180, height = 60, class: className = '' } = Astro.props;
---
<svg class={className} x={x} y={y} width={width} height={height} viewBox="0 0 330 110" aria-hidden="true">
  {specimen.glyphs.map((glyph, i) => <svg x={i * 110} y="0" width="100" height="110" viewBox={specimen.viewBox}><path d={glyph.d} /></svg>)}
</svg>
