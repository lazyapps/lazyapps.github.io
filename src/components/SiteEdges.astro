<div class="edge-top" aria-hidden="true"></div>
<div class="edge-bottom" aria-hidden="true"></div>

<script>
  import { mountSafariEdges } from '../scripts/safari-edge-colors';

  let dispose = mountSafariEdges();
  window.addEventListener('pagehide', () => dispose());
  window.addEventListener('pageshow', event => {
    if (event.persisted) dispose = mountSafariEdges();
  });
</script>
