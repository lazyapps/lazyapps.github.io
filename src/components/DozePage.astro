---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { DOZE_LOCALES, DOZE_LANGUAGE_OPTIONS, DOZE_RELEASE } from '../i18n/doze-locales.mjs';
import SiteHeader from './SiteHeader.astro';
import LanguagePicker from './LanguagePicker.astro';
import SiteGrain from './SiteGrain.astro';
import SiteFooterBase from './SiteFooterBase.astro';
import SocialMeta from './SocialMeta.astro';
import SoftwareApplication from './SoftwareApplication.astro';
import SiteEdges from './SiteEdges.astro';
import SitePreloader from './SitePreloader.astro';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
import appIcon from '$assets/img/doze-icon.png';
import menubarIcon from '$assets/img/doze-menubar.png';
import dayLandscape from '$assets/img/doze-landscape-day-cozy-doodle.png';
import nightLandscape from '$assets/img/doze-landscape-night-cozy-doodle.png';
import sunArtwork from '$assets/img/doze-sun-cozy-doodle.png';
import moonArtwork from '$assets/img/doze-moon-cozy-doodle.png';
import appleSymbolUrl from '$assets/img/doze-system-apple.png?url';
import wifiSymbolUrl from '$assets/img/doze-system-wifi.png?url';
import batterySymbolUrl from '$assets/img/doze-system-battery.png?url';
import favicon16 from '$assets/img/doze/icon-small-16-1x.png?url';
import favicon32 from '$assets/img/doze/icon-small-32-1x.png?url';
const { code = '' } = Astro.props;
const iconUrl = appIcon.src;
const t = DOZE_LOCALES[code];
const shots = import.meta.glob<{ default: ImageMetadata }>('../../scripts/assets/presskit/doze-panel-*.png', { eager: true });
const shot = (theme: string) => shots[`../../scripts/assets/presskit/doze-panel-${t.htmlLang.toLowerCase()}-${theme}.png`].default;
const cards = import.meta.glob<{ default: string }>('../assets/img/doze-opengraph-*.png', { eager: true, query: '?url' });
const ogUrl = cards[`../assets/img/${t.ogAsset}`].default;
---
<!doctype html>
<html lang={t.htmlLang} dir={t.htmlDir} class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  <meta name="theme-color" content="#f8f8f6">
  {Object.values(DOZE_LOCALES).map(locale => <link rel="alternate" hreflang={locale.htmlLang} href={locale.canonical} />)}
  <link rel="alternate" hreflang="x-default" href={DOZE_LOCALES.en.canonical}>
  <SocialMeta title={t.title} description={t.description} url={t.canonical} image={`https://lazyapps.com${ogUrl}`} imageAlt={t.brand} imageWidth={1200} imageHeight={630} locale={t.ogLocale} />
  <SoftwareApplication name={t.name} description={t.description} url={t.canonical} language={t.htmlLang} operatingSystem="macOS 13.0 or later" downloadUrl={DOZE_RELEASE.downloadUrl ?? undefined} image={`https://lazyapps.com${iconUrl}`} applicationCategory="UtilitiesApplication" />
  <link rel="icon" type="image/png" sizes="16x16" href={favicon16}>
  <link rel="icon" type="image/png" sizes="32x32" href={favicon32}>
  <link rel="stylesheet" href={siteCssUrl}>
  <script is:inline>
    document.documentElement.classList.remove('no-js');
    setTimeout(() => {
      document.documentElement.classList.add('is-page-theme', 'is-loaded');
      document.getElementById('loader')?.remove();
    }, 6000);
  </script>
</head>
<body class="doze-page">
  <SiteEdges />
  <SiteGrain animated />
  <SitePreloader name="DOZE" />
  <a class="skip-link" href="#main">{t.skip}</a>
  <div class="wrap">
    <SiteHeader name={t.name} icon={iconUrl} homeLabel={t.home}>
      <LanguagePicker label={t.select} current={t.selectedUrl} options={DOZE_LANGUAGE_OPTIONS} />
    </SiteHeader>
    <main id="main">
      <section class="doze-hero" aria-labelledby="hero-title">
        <h1 id="hero-title" class="dsp"><span>{t.headline[0]}</span> <span>{t.headline[1]}</span></h1>
        <div class="doze-preview" data-doze-appearance="light">
          <div class="doze-desktop">
            <div class="doze-menubar" dir="ltr">
              <img class="doze-menubar__apple" aria-hidden="true" src={appleSymbolUrl} width="14" height="17" alt="" />
              <div class="doze-menubar__status">
                <span class="doze-menubar__item" aria-hidden="true"><img src={menubarIcon.src} width={menubarIcon.width / 2} height={menubarIcon.height / 2} alt="" /></span>
                <img class="doze-menubar__wifi" aria-hidden="true" src={wifiSymbolUrl} width="17" height="14" alt="" />
                <img class="doze-menubar__battery" aria-hidden="true" src={batterySymbolUrl} width="23" height="12" alt="" />
                <div class="doze-themes" data-doze-themes hidden aria-label={t.preview} role="group">
                  <button type="button" data-doze-theme="light" aria-pressed="true" aria-controls="doze-panel-light">{t.light}</button>
                  <button type="button" data-doze-theme="dark" aria-pressed="false" aria-controls="doze-panel-dark">{t.dark}</button>
                </div>
              </div>
            </div>
            <div class="doze-atmosphere doze-atmosphere--light" aria-hidden="true">
              <Image class="doze-celestial" src={sunArtwork} width={160} format="webp" quality={90} alt="" />
              <Image class="doze-landscape" src={dayLandscape} width={1200} format="webp" quality={90} alt="" />
            </div>
            <div class="doze-atmosphere doze-atmosphere--dark" aria-hidden="true">
              <Image class="doze-celestial" src={moonArtwork} width={160} format="webp" quality={90} alt="" />
              <Image class="doze-landscape" src={nightLandscape} width={1200} format="webp" quality={90} alt="" />
            </div>
            <div class="doze-popover">
            {['light', 'dark'].map(theme => <div id={`doze-panel-${theme}`} class="doze-panel" data-doze-panel={theme} hidden={theme !== 'light'}>
              <Image src={shot(theme)} width={384} format="webp" quality={90} densities={[1, 2]} loading={theme === 'light' ? 'eager' : 'lazy'} alt={`${t.shot} · ${theme === 'light' ? t.light : t.dark}`} />
            </div>)}
            </div>
          </div>
        </div>
        <div class="doze-hero__copy">
          <div class="doze-hero__intro">
            <p class="doze-intro">{t.description}</p>
          </div>
          <div class="doze-cta">
            <a class="button-023" href={t.ctaUrl}>
              <span class="button-023__bg"><span style="--index:0" class="button-023__bg-inner is--first"></span><span style="--index:1" class="button-023__bg-inner is--second"></span></span>
              <span class="button-023__inner"><span class="button-023__text is--first">{t.cta} ↗</span><span aria-hidden="true" class="button-023__text is--second">{t.cta} ↗</span></span>
            </a>
          </div>
        </div>
      </section>
      <section class="doze-features" aria-label={t.positioning}>
        {t.features.map(([title, text], index) => <article>
          <h2 class="dsp">{title}</h2>{index === 2
            ? <ul>{text.split('\n').map(item => <li>{item}</li>)}</ul>
            : <p>{text}</p>}
        </article>)}
      </section>
      <section class="doze-setup" aria-labelledby="setup-title">
        <h2 id="setup-title" class="dsp">{t.setup}</h2>
        <ol>{t.steps.map(step => <li>{step}</li>)}</ol>
      </section>
      <section class="doze-details" aria-labelledby="details-title">
        <h2 id="details-title" class="dsp">{t.details}</h2>
        <div>{t.faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
      </section>

    </main>
    <footer><SiteFooterBase locale={t.htmlLang} pressKit="/doze/presskit/" /></footer>
  </div>
  <script is:inline src={gsapUrl}></script>
  <script is:inline src={scrollTriggerUrl}></script>
  <script is:inline src={customEaseUrl}></script>
  <script is:inline src={splitTextUrl}></script>
  <script is:inline src={logoRevealUrl}></script>
  <script is:inline src={siteJsUrl}></script>
  <script>
    const controls = document.querySelector<HTMLElement>('[data-doze-themes]');
    if (controls) {
      controls.hidden = false;
      const preview = controls.closest<HTMLElement>('.doze-preview')!;
      const bar = preview.querySelector<HTMLElement>('.doze-menubar')!;
      const item = bar.querySelector<HTMLElement>('.doze-menubar__item')!;
      const alignPopover = () => {
        const barBounds = bar.getBoundingClientRect();
        const itemBounds = item.getBoundingClientRect();
        preview.style.setProperty('--menu-anchor', `${barBounds.right - itemBounds.left - itemBounds.width / 2}px`);
      };
      new ResizeObserver(alignPopover).observe(bar);
      alignPopover();
      controls.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
        button.addEventListener('click', () => {
          document.querySelector<HTMLElement>('.doze-preview')!.dataset.dozeAppearance = button.dataset.dozeTheme;
          controls.querySelectorAll('button').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
          document.querySelectorAll<HTMLElement>('[data-doze-panel]').forEach(panel => {
            panel.hidden = panel.dataset.dozePanel !== button.dataset.dozeTheme;
          });
        });
      });
    }
  </script>
</body>
</html>
<style>
  .skip-link{position:fixed;inset-block-start:10px;inset-inline-start:16px;padding:12px 18px;background:var(--paper);transform:translateY(-160%);border:2px solid var(--ink);border-radius:8px}
  .skip-link:focus{transform:none}
  .doze-hero{padding-block:clamp(28px,4vw,56px) var(--space-section)}
  h1{font-size:clamp(56px,10.5vw,128px);margin:0 0 clamp(28px,4vw,52px);line-height:1.02}
  h1:lang(zh),h1:lang(ja),h1:lang(ko){font-size:clamp(44px,9.6vw,96px);line-height:1.2}
  h1:lang(ar),h1:lang(hi){font-size:clamp(38px,6.2vw,88px);line-height:1.35}
  h1 span{display:block;line-height:inherit}
  .doze-hero__copy{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:clamp(28px,4vw,56px);margin-block-start:clamp(28px,4vw,48px)}
  .doze-hero__intro{min-width:0}
  .doze-intro{max-width:50ch;font-size:clamp(18px,1.6vw,22px);line-height:1.6;margin:0;color:var(--ink);text-wrap:pretty}
  .doze-cta{display:flex;flex-direction:column;align-items:flex-start;gap:12px}
  .doze-cta .button-023{--button-023-padding:1em 1.5em;--button-023-click-scale:.96;min-height:52px;max-width:100%}
  button:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  .doze-preview{--popover-surface:#faf9ef;--popover-inset:clamp(24px,4vw,56px);--menu-anchor:90px;min-width:0;width:100%}
  .doze-themes{align-self:center;display:flex;gap:0;height:28px;padding:2px;border-radius:999px;background:#1717170d;box-shadow:inset 0 0 0 1px #1717170d;font-size:13px;line-height:1}
  .doze-themes[hidden],.doze-panel[hidden]{display:none}
  .doze-themes button{position:relative;min-width:40px;height:24px;border:0;border-radius:999px;background:none;color:var(--ink);font:inherit;cursor:pointer;padding:4px 8px}
  .doze-themes button::after{content:"";position:absolute;inset:-10px 0}
  .doze-themes button[aria-pressed=true]{background:var(--ink);color:var(--paper)}
  .doze-desktop{position:relative;isolation:isolate;padding-block-end:clamp(28px,4vw,56px);border-radius:var(--r-card);background:#faf9ef;box-shadow:inset 0 0 0 1px #1717170d}
  .doze-menubar{position:relative;z-index:2;height:36px;background:#eaf0f1;border-radius:var(--r-card) var(--r-card) 0 0;margin-block-end:22px;box-shadow:0 1px 0 #1717170d}
  .doze-menubar__apple{position:absolute;inset-inline-start:17px;top:9px}
  .doze-menubar__status{position:absolute;right:12px;top:0;display:flex;align-items:center;gap:12px;height:36px}
  .doze-menubar__item{flex:none;height:28px;width:28px;display:grid;place-items:center;background:#17171714;border-radius:50%}
  .doze-popover{position:relative;z-index:1;width:384px;max-width:calc(100% - 2 * var(--popover-inset));margin-left:auto;margin-right:var(--popover-inset);border-radius:14px;box-shadow:0 28px 64px -12px #14202f59,0 10px 24px -6px #14202f40,0 0 0 1px #1717172b}
  .doze-popover::before{content:"";position:absolute;right:calc(var(--menu-anchor) - var(--popover-inset) - 10px);top:-10px;width:20px;height:20px;transform:rotate(45deg);border-start-start-radius:4px;background:var(--popover-surface);box-shadow:-1px -1px 0 0 #17171718}
  .doze-atmosphere{position:absolute;inset:36px 0 0;z-index:-1;pointer-events:none;overflow:hidden;border-radius:0 0 var(--r-card) var(--r-card)}
  .doze-atmosphere :global(.doze-landscape){position:absolute;inset-inline:0;bottom:0;width:100%;height:auto}
  .doze-atmosphere :global(.doze-celestial){position:absolute;left:clamp(32px,11vw,160px);top:clamp(24px,4vw,56px);width:160px;height:auto}
  [data-doze-appearance=light] .doze-atmosphere--dark,[data-doze-appearance=dark] .doze-atmosphere--light{display:none}
  .doze-panel{position:relative;border-radius:14px;overflow:hidden}
  .doze-preview[data-doze-appearance=dark]{--popover-surface:#29384f}
  [data-doze-appearance=dark] .doze-desktop{background:#29384f}
  [data-doze-appearance=dark] .doze-popover{box-shadow:0 28px 64px -12px #0009,0 10px 24px -6px #0006,0 0 0 1px #ffffff18}
  [data-doze-appearance=dark] .doze-menubar{background:#344358}
  [data-doze-appearance=dark] .doze-themes{background:#ffffff10;box-shadow:inset 0 0 0 1px #ffffff14}
  [data-doze-appearance=dark] .doze-themes button{color:var(--paper)}
  [data-doze-appearance=dark] .doze-themes button[aria-pressed=true]{background:var(--paper);color:var(--ink)}
  [data-doze-appearance=dark] .doze-menubar__item{background:#ffffff22}
  [data-doze-appearance=dark] .doze-menubar img{filter:invert(1)}
  .doze-panel img{width:100%;height:auto;display:block}
  .doze-features{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-grid);padding-block:var(--space-grid) var(--space-section)}
  .doze-features article{padding:var(--space-card);border:1px solid #17171714;border-radius:var(--r-card);background:oklch(0.93 0.085 94);transform:rotate(-1deg)}
  .doze-features article:nth-child(2){background:oklch(0.895 0.045 114);transform:rotate(1deg)}
  .doze-features article:nth-child(3){background:var(--app-doze)}
  .doze-features h2{font-size:clamp(28px,3.2vw,44px);margin:0 0 16px}
  .doze-features :is(p,li){font-size:1rem;line-height:1.7;color:var(--ink);text-wrap:pretty}
  .doze-features ul{margin:0;padding-inline-start:1.1em}
  .doze-features li+li{margin-block-start:.65em}
  .doze-setup{display:grid;grid-template-columns:1fr 1.2fr;gap:var(--space-grid);border-block-start:1px solid var(--line);padding-block:var(--space-grid) var(--space-section)}
  .doze-setup h2,.doze-details>h2{font-size:clamp(28px,4.2vw,60px);margin:0}
  .doze-setup ol{margin:0;padding-inline-start:1.5em;display:grid;gap:20px}
  .doze-setup li{font-size:1rem;line-height:1.75;padding-inline-start:8px}
  .doze-setup li::marker{color:var(--accent);font-weight:600}
  .doze-details{display:grid;grid-template-columns:1fr 1.2fr;gap:var(--space-grid);padding-block:var(--space-grid) var(--space-section);border-block-start:1px solid var(--line)}
  details{border-block-end:1px solid var(--line)}
  summary{display:flex;align-items:center;justify-content:space-between;gap:16px;list-style:none;cursor:pointer;padding:22px 0;min-height:48px;font-size:1rem;font-weight:600;line-height:1.5}
  summary::-webkit-details-marker{display:none}
  summary span{font:400 24px var(--sans);flex:none}
  details[open] summary span{transform:rotate(45deg)}
  .doze-details p{font-size:1rem;line-height:1.75;margin:0;padding-block-end:24px;color:var(--muted)}
  @media(max-width:800px){.doze-hero__copy{grid-template-columns:minmax(0,1fr);gap:24px}.doze-preview{--popover-inset:24px}.doze-features{grid-template-columns:1fr}.doze-features article{transform:none}.doze-features article:nth-child(2){transform:none}}
  @media(max-width:600px){.doze-cta{align-items:stretch}.doze-cta .button-023{width:100%}}
  @media(max-width:600px){.doze-preview{--popover-inset:14px}.doze-desktop{padding-block-end:18px}.doze-atmosphere :global(.doze-celestial){display:none}h1{font-size:clamp(48px,11vw,64px)}h1:lang(zh),h1:lang(ja),h1:lang(ko),h1:lang(ar),h1:lang(hi){font-size:clamp(34px,8.7vw,46px)}.doze-features h2{font-size:32px}.doze-setup,.doze-details{grid-template-columns:1fr;gap:28px}}
</style>
