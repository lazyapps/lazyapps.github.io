---
import NativeAppIcon from './NativeAppIcon.astro';
interface Props { base: string; asset: any; metadata: any; lang?: string; formats?: { asset: any; metadata: any }[]; }
const { base, asset, metadata, lang = 'en', formats = [] } = Astro.props;
---
<figure class="asset" data-kind={asset.kind} lang={lang}>
  <div class="asset-preview">
    <a class="asset-preview__image" href={base + asset.path} aria-label={asset.label}>{asset.kind === 'icon' ? <NativeAppIcon slug={base.split('/')[2]} size={180} alt={asset.label} /> : <img src={base + asset.path} alt={asset.label} width={metadata.width} height={metadata.height} loading="lazy" decoding="async" />}</a>
    <div class="asset-downloads" dir="ltr">{[{ asset, metadata }, ...formats].map(item => <a href={base + item.asset.path} download aria-label={`${item.asset.label} · ${item.asset.path} ↓`}><span aria-hidden="true">↓</span> <span>{item.metadata.format}</span></a>)}</div>
  </div>
  <figcaption class="asset-caption"><h3>{asset.label}</h3><p class="dimensions" dir="ltr">{metadata.width} × {metadata.height} · {asset.path}</p><p class="note">{asset.note}</p></figcaption>
</figure>

<style>
  .asset-preview{position:relative}
  .asset-preview__image{position:absolute;inset:68px 24px 24px;display:flex;align-items:center;justify-content:center;min-width:0}
  .asset-downloads{position:absolute;top:12px;right:12px;display:flex;gap:10px}
  .asset-downloads a{
    position:relative;display:inline-flex;align-items:center;justify-content:center;gap:4px;min-width:52px;min-height:32px;padding:0 8px;
    border-radius:999px;background:var(--paper);color:var(--ink);font:600 11px/1 var(--sans);text-decoration:none;
    box-shadow:0 0 0 1px rgba(0,0,0,.08),0 2px 4px rgba(0,0,0,.06);
    transition:background-color .18s ease;
  }
  .asset-downloads a::before{content:"";position:absolute;inset:-6px 0}
  @media(hover:hover) and (pointer:fine){.asset-downloads a:hover{background:color-mix(in oklch,var(--paper) 94%,var(--ink))}}
  @media(prefers-reduced-motion:reduce){.asset-downloads a{transition:none}}
</style>
