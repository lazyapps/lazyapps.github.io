---
interface Props {
  t: any;
  code: string;
}

const { t, code } = Astro.props;
const SITE = 'https://lazyapps.com';

import SocialMeta from './SocialMeta.astro';
import StructuredData from './StructuredData.astro';
import { KEYHOP_STATUS } from '../i18n/keyhop-status.mjs';
import LanguagePicker from './LanguagePicker.astro';
import SiteHeader from './SiteHeader.astro';
import SiteGrain from './SiteGrain.astro';
import SiteFooterBase from './SiteFooterBase.astro';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
import keyhopIconUrl from '$assets/img/keyhop-icon.png?url';
import safariIconUrl from '$assets/img/keyhop/apps/safari.png?url';
import chromeIconUrl from '$assets/img/keyhop/apps/chrome.png?url';
import mailIconUrl from '$assets/img/keyhop/apps/mail.png?url';
import messagesIconUrl from '$assets/img/keyhop/apps/messages.png?url';
import calendarIconUrl from '$assets/img/keyhop/apps/calendar.png?url';
import notesIconUrl from '$assets/img/keyhop/apps/notes.png?url';
import xcodeIconUrl from '$assets/img/keyhop/apps/xcode.png?url';
import figmaIconUrl from '$assets/img/keyhop/apps/figma.png?url';
import telegramIconUrl from '$assets/img/keyhop/apps/telegram.png?url';
import vlcIconUrl from '$assets/img/keyhop/apps/vlc.png?url';
import keyhopOpengraphUrl from '$assets/img/keyhop-opengraph.png?url';
import keyhopOpengraphSharedUrl from '$assets/img/keyhop-opengraph-shared.png?url';
import keyhopOpengraphZhHantUrl from '$assets/img/keyhop-opengraph-zh-hant.png?url';
import filmCopy from '../i18n/keyhop-film-copy.json';

const filmLocale = code === '' ? 'zh-hans' : code;
const film = filmCopy[filmLocale];
const heroVideoUrl = '/v/keyhop/hero-v4.mp4';
const heroVideoPoster = '/v/keyhop/hero-v4.jpg';

const repositoryUrl = 'https://github.com/cxa/keyhop';
const [statusHeading, statusDescription] = KEYHOP_STATUS[t.htmlLang];
const title = `${t.title.split(' — ')[0]} — ${statusHeading}`;
const layoutLabel = t.layoutAria ?? 'Keyboard layout';
const modifierLabel = t.modifierAria ?? 'Leader modifier';
const demoApps = [
  ['Safari', safariIconUrl],
  ['Chrome', chromeIconUrl],
  ['Mail', mailIconUrl],
  ['Messages', messagesIconUrl],
  ['Calendar', calendarIconUrl],
  ['Notes', notesIconUrl],
  ['Xcode', xcodeIconUrl],
  ['Figma', figmaIconUrl],
  ['Telegram', telegramIconUrl],
  ['VLC', vlcIconUrl],
];
const options = [
  ['zh-Hans', '/keyhop/', '简体中文'],
  ['en', '/keyhop/en/', 'English'],
  ['zh-Hant', '/keyhop/zh-hant/', '繁體中文'],
  ['es', '/keyhop/es/', 'Español'],
  ['pt-BR', '/keyhop/pt-br/', 'Português'],
  ['fr', '/keyhop/fr/', 'Français'],
  ['de', '/keyhop/de/', 'Deutsch'],
  ['ja', '/keyhop/ja/', '日本語'],
  ['ko', '/keyhop/ko/', '한국어'],
  ['ru', '/keyhop/ru/', 'Русский'],
  ['ar', '/keyhop/ar/', 'العربية'],
  ['hi', '/keyhop/hi/', 'हिन्दी'],
];

const alternates = [
  ['zh-Hans', ''], ['en', 'en/'], ['zh-Hant', 'zh-hant/'], ['es', 'es/'],
  ['pt-BR', 'pt-br/'], ['fr', 'fr/'], ['de', 'de/'], ['ja', 'ja/'],
  ['ko', 'ko/'], ['ru', 'ru/'], ['ar', 'ar/'], ['hi', 'hi/'], ['x-default', 'en/'],
];
const ogLocales = {
  '': 'zh_CN', en: 'en_US', 'zh-hant': 'zh_TW', es: 'es_ES', 'pt-br': 'pt_BR',
  fr: 'fr_FR', de: 'de_DE', ja: 'ja_JP', ko: 'ko_KR', ru: 'ru_RU', ar: 'ar_AR', hi: 'hi_IN',
};
const socialImageUrl = {
  '': keyhopOpengraphUrl,
  'zh-hant': keyhopOpengraphZhHantUrl,
}[code] ?? keyhopOpengraphSharedUrl;

---

<!doctype html>
<html lang={t.htmlLang} dir={t.htmlDir ?? 'ltr'} class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={statusDescription}>
  <meta name="theme-color" content="#171717" data-page-color="#e8e8e6">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" data-page-color="#e8e8e6">
  {alternates.map(([hreflang, path]) => <link rel="alternate" hreflang={hreflang} href={`${SITE}/keyhop/${path}`} />)}
  <SocialMeta
    title={title}
    description={statusDescription}
    url={t.canonical}
    image={`${SITE}${socialImageUrl}`}
    imageAlt={t.ogTitle}
    imageWidth={1200}
    imageHeight={630}
    locale={ogLocales[code] ?? 'en_US'}
  />
  <StructuredData data={{
    '@context': 'https://schema.org', '@type': 'WebPage',
    name: title, description: statusDescription, url: t.canonical, inLanguage: t.htmlLang,
  }} />
  <link rel="icon" type="image/png" href={keyhopIconUrl}>
  <link rel="stylesheet" href={siteCssUrl}>
  <script is:inline>
    document.documentElement.classList.remove('no-js');
    setTimeout(() => {
      document.documentElement.classList.add('is-page-theme', 'is-loaded');
      document.getElementById('loader')?.remove();
      document.querySelectorAll('meta[name="theme-color"][data-page-color]').forEach((meta) => {
        meta.setAttribute('content', meta.getAttribute('data-page-color'));
      });
    }, 6000);
  </script>
  <style is:inline>
    :root{
      --keyhop-cyan:oklch(0.600 0.090 215);
      --keyhop-coral:oklch(0.600 0.207 25);
      --keyhop-green:oklch(0.600 0.160 145);
      --keyhop-violet:oklch(0.600 0.220 300);
      --accent:var(--keyhop-violet);
      --c1:oklch(0.800 0.099 215);
      --c2:oklch(0.800 0.080 25);
      --c3:oklch(0.800 0.176 145);
      --c4:oklch(0.800 0.083 300);
    }
    p,dd{text-wrap:pretty}
    section.phero.wrap{padding-top:clamp(8px,1.5vw,18px);--h1-size:clamp(38px,6.2vw,96px)}
    .phero__h1{margin:clamp(28px,4vw,64px) auto 0;font-size:var(--h1-size);max-width:calc(13 * var(--h1-size));text-align:center;text-wrap:balance}
    .phero__h1 .hero-title-pairs{display:flex;flex-wrap:wrap;justify-content:center;column-gap:1em;line-height:1.08}
    .phero__h1 .hero-title-phrase{position:relative;flex:none;white-space:nowrap;line-height:1.08}
    .phero__h1 .hero-title-comma{position:absolute;inset-inline-start:100%;line-height:inherit}
    .phero__sub{margin:clamp(18px,2.2vw,32px) auto 0;font-size:1rem;color:var(--muted);max-width:42rem;text-align:center}
    .phero__sub:not(.bounds__note){text-wrap:balance}
    .phero__cta{margin-top:clamp(22px,2.6vw,38px);display:flex;justify-content:center;gap:.75rem;flex-wrap:wrap}
    .hero-film{container-type:inline-size;position:relative;margin:clamp(24px,3vw,42px) 0 0;border-radius:min(2vw,24px);overflow:hidden;background:#f5e8dc}
    .hero-film video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
    .hero-captions{position:absolute;inset-inline:70px;bottom:1.25cqw;display:grid;grid-template-columns:minmax(0,1fr);pointer-events:none}
    .hero-captions[hidden]{display:none}
    .hero-caption{grid-area:1/1;justify-self:center;align-self:end;width:max-content;max-width:100%;padding:.9375cqw 1.5625cqw;border-radius:.78125cqw;background:rgba(24,20,28,.71);color:#fff;font:400 3.4375cqw/1.2 var(--sans);text-align:center;text-wrap:balance;visibility:hidden}
    .hero-caption[data-active]{visibility:visible}
    .hero-controls{position:absolute;right:clamp(4px,1vw,12px);bottom:clamp(4px,1vw,12px);display:flex;gap:6px}
    .hero-controls[hidden]{display:none}
    .hero-controls button{display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:rgba(24,20,28,.55);color:#fff;cursor:pointer}
    .hero-controls button:hover{background:rgba(24,20,28,.75)}
    .hero-controls button:focus-visible{outline:2px solid #fff;outline-offset:2px}
    .hero-controls svg{width:18px;height:18px}
    .hero-controls .icon-pause,.hero-controls .icon-muted{display:none}
    .hero-controls [data-playing] .icon-play,.hero-controls [data-muted] .icon-sound{display:none}
    .hero-controls [data-playing] .icon-pause,.hero-controls [data-muted] .icon-muted{display:block}
    @media (max-width:640px){
      .hero-captions{position:relative;inset:auto;bottom:auto;width:calc(100% - 112px);margin:-20px auto 8px}
      .hero-caption{font-size:15px;line-height:1.35;padding:4px 8px;border-radius:5px}
      .hero-controls{gap:2px}
      .hero-controls button{width:24px;height:24px}
      .hero-controls svg{width:14px;height:14px}
    }
    .card__demo{grid-column:1/-1;min-width:0}
    .gesture-demo{margin-top:0}
    .gesture{position:relative;border-radius:min(2vw,24px);background:oklch(0.210 0.050 300);color:#fff;padding:clamp(24px,3.2vw,44px);overflow:hidden}
    .gesture__leader{display:flex;align-items:center;justify-content:center;gap:clamp(8px,1.2vw,14px)}
    .gesture__leader-key{display:grid;place-items:center;width:clamp(48px,6vw,72px);height:clamp(48px,6vw,72px);border:1px solid oklch(0.600 0.090 215 / .52);border-radius:min(1.2vw,14px);background:oklch(0.600 0.090 215 / .12);font:600 clamp(1rem,2vw,1.5rem)/1 var(--sans);will-change:transform,background-color,border-color}
    .gesture__leader-key:first-child{animation:leader-first 1.8s linear infinite}.gesture__leader-key:last-child{animation:leader-second 1.8s linear infinite}
    .gesture__matrix{margin-top:clamp(28px,4vw,48px);display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:clamp(3px,.8vw,10px)}
    .gesture__binding{display:grid;justify-items:center;gap:clamp(7px,1.2vw,14px);min-width:0}
    .gesture__app{display:block;width:min(clamp(25px,4.6vw,56px),100%);aspect-ratio:1;object-fit:contain;opacity:.48;filter:saturate(.65);will-change:transform,opacity,filter}
    .gesture__controls{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.75rem}
    .gesture__select{display:inline-grid;grid-template-columns:minmax(0,1fr);color:var(--ink)}
    .gesture__select select{min-height:40px;appearance:none;border:1px solid rgba(23,23,23,.14);border-radius:999px;background:rgba(255,255,255,.56);color:inherit;padding-block:.4rem;padding-inline-start:.75rem;font:500 .8125rem/1.2 var(--sans);cursor:pointer}
    .gesture__select--layout{color:var(--muted);opacity:.62}.gesture__select--layout select{border-color:transparent;background:transparent}
    .gesture__select select:focus-visible{outline:2px solid var(--keyhop-violet);outline-offset:2px}
    .gesture__slot{display:grid;place-items:center;width:100%;aspect-ratio:1;border:1px solid rgba(255,255,255,.16);border-radius:min(.8vw,10px);font:500 clamp(.6875rem,1.4vw,1.125rem)/1 var(--mono);color:rgba(255,255,255,.72);will-change:transform,background-color,border-color}
    .gesture__binding[data-active] .gesture__slot{animation:slot-press 1.8s linear both}.gesture__binding[data-active] .gesture__app{animation:app-launch 1.8s linear both}
    @keyframes leader-first{0%,8%,24%,100%{transform:scale(1);background:oklch(0.600 0.090 215 / .12);border-color:oklch(0.600 0.090 215 / .52)}16%{transform:scale(.9);background:oklch(0.600 0.090 215 / .32);border-color:var(--keyhop-cyan)}}
    @keyframes leader-second{0%,25%,41%,100%{transform:scale(1);background:oklch(0.600 0.090 215 / .12);border-color:oklch(0.600 0.090 215 / .52)}33%{transform:scale(.9);background:oklch(0.600 0.090 215 / .32);border-color:var(--keyhop-cyan)}}
    @keyframes slot-press{0%,44%,66%,100%{transform:scale(1);background:transparent;border-color:rgba(255,255,255,.16)}54%{transform:scale(.86);background:oklch(0.600 0.220 300 / .32);border-color:var(--keyhop-violet)}}
    @keyframes app-launch{0%,50%,100%{opacity:.48;filter:saturate(.65);transform:translateY(0) scale(1)}64%,86%{opacity:1;filter:saturate(1);transform:translateY(-7px) scale(1.12)}}
    @media (max-width:560px){
      .gesture{padding-inline:clamp(14px,4vw,24px)}
      .gesture__matrix{gap:3px}
      .gesture__binding{gap:7px}
      .gesture__slot{font-size:.625rem}
      .gesture__controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}
      .gesture__select{width:100%;min-width:0}
      .gesture__select select{width:100%;min-width:0;min-height:48px;padding-inline-start:.5rem;font-size:.9375rem}
    }
    @media (max-width:340px){.phero__h1 .hero-title-phrase{font-size:.96em}}
    @media (prefers-reduced-motion:reduce){.gesture__leader-key,.gesture__binding[data-active] .gesture__slot,.gesture__binding[data-active] .gesture__app{animation:none}.gesture__binding[data-active] .gesture__slot{background:oklch(0.600 0.220 300 / .32);border-color:var(--keyhop-violet)}.gesture__binding[data-active] .gesture__app{opacity:1;filter:saturate(1)}}

    .deck{padding-top:var(--space-section)}
    .card{position:relative;background:var(--fill);color:var(--fg,var(--ink));border:1px solid rgba(23,23,23,.08);border-radius:var(--r-card);padding:var(--space-card);margin-top:-8px}
    .card:first-child{margin-top:0}.card:nth-child(1){--fill:var(--c1)}.card:nth-child(2){--fill:var(--c2)}.card:nth-child(3){--fill:var(--c3)}.card:nth-child(4){--fill:var(--c4)}
    .card:nth-child(odd){transform:rotate(-2deg)}.card:nth-child(even){transform:rotate(2deg)}
    .card__grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);column-gap:var(--space-grid);row-gap:clamp(24px,3vw,36px);align-items:start}
    .card__title{font-size:clamp(26px,3.4vw,46px);text-wrap:balance}.card__p{font-size:1.0625rem;line-height:1.85}
    @media (max-width:860px){.card__grid{grid-template-columns:1fr}}

    .pair{padding-top:var(--space-section)}
    .pair__h2,.bounds__h2{margin:0;font-size:clamp(28px,4.2vw,60px);max-width:16em}
    .pair__grid{margin-top:clamp(24px,3vw,44px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-grid)}
    .pair__cell{border:1px solid rgba(23,23,23,.1);border-radius:var(--r-card);padding:var(--space-card);display:grid;gap:.875rem;align-content:start}
    .pair__cell--src{background:#fff}.pair__cell--out{background:var(--c4)}
    .pair__cell dd,.pair__cell>p{margin:0;font-size:1.0625rem;line-height:1.75}
    .pair__why{margin-top:var(--space-grid);border:1px solid rgba(23,23,23,.1);border-radius:var(--r-card);background:#fff;padding:var(--space-card)}
    .pair__why p:last-child{font-size:1.0625rem;line-height:1.75}
    @media (max-width:860px){.pair__grid{grid-template-columns:1fr}}

    .bounds{padding-top:var(--space-section)}
    .bounds__h2{font-size:clamp(26px,3.8vw,54px)}
    .bounds__note{margin:1.25rem 0 0;text-align:start}
    .bounds__grid{margin:clamp(24px,3vw,44px) 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-grid)}
    .bounds__q{color:var(--muted);font-size:.9375rem}.bounds__a{margin:.5rem 0 0;font-size:.9375rem;line-height:1.75}
    @media (max-width:860px){.bounds__grid{grid-template-columns:1fr}}

    .next__plate.next__plate--icon{max-width:120px;border-radius:24%;border:none}
    .brew{margin-top:clamp(28px,3.5vw,56px);border:1px solid rgba(23,23,23,.12);border-radius:var(--r-card);background:var(--ink);color:var(--paper);padding:var(--space-card);display:grid;gap:1rem;min-width:0}
    .brew>*{min-width:0}
    .brew pre{margin:0;font:400 .875rem/1.9 var(--mono);white-space:pre-wrap;word-break:break-all}.brew pre .p{opacity:.45}
    .brew a.brew__download{white-space:normal;overflow-wrap:anywhere;text-decoration-line:underline;text-decoration-color:color-mix(in srgb,currentColor 48%,transparent);text-decoration-thickness:.0625em;text-underline-offset:.2em;text-decoration-skip-ink:auto}
    .brew__download:hover{text-decoration-color:currentColor}
    .archive-notice{margin-top:32px;padding:28px;border:1px solid var(--line);border-radius:var(--r-card);background:oklch(0.92 0.14 95)}
    .archive-notice h2{font:600 1.1rem/1.4 var(--sans);margin:0 0 12px;text-wrap:balance}
    .archive-notice a{font:600 .8rem/1.5 var(--sans);text-decoration:underline;text-underline-offset:.2em}
    .keyhop-footer__inner{margin-top:var(--space-grid);border-top:1px solid var(--line);padding-top:28px}
    .keyhop-footer__notices{display:grid;gap:8px;max-width:68ch;margin-inline:auto;text-align:center;color:var(--muted);font:400 .6667rem/1.4 var(--sans);text-transform:uppercase;letter-spacing:.04em}
    .keyhop-footer__notices p{max-width:68ch;line-height:inherit}
    .keyhop-footer__notices a{text-decoration:underline;text-decoration-color:color-mix(in srgb,currentColor 45%,transparent);text-underline-offset:.2em}
    .keyhop-footer__notices a:hover{text-decoration-color:currentColor}
  </style>
</head>

<body>
  <SiteGrain animated />
  <div data-load-wrap class="loader" id="loader" aria-hidden="true">
    <div data-load-bg class="loader__bg"><div data-load-progress class="loader__bg-bar"></div></div>
    <div data-load-container class="loader__container">
      <div class="loader__logo-wrap">
        <div class="loader__logo-item is--base"><span class="loader__logo-img" lang="en">KEYHOP</span></div>
        <div data-load-logo class="loader__logo-item is--top"><span class="loader__logo-img" lang="en">KEYHOP</span></div>
      </div>
    </div>
  </div>

  <SiteHeader class="wrap" name={t.appTitle.replace(/<[^>]*>/g, '')} icon={keyhopIconUrl} homeLabel={t.homeAria}>
        <LanguagePicker label={t.selectAria} current={t.selectedUrl} storageKey="keyhop.locale" options={options.map(([language, url, label]) => ({ language, url, label }))} />
      </SiteHeader>

<main>
    <section class="phero wrap">


      <div data-reveal-group data-stagger="110" data-distance="1.2em" data-start="top 94%">
        <h1 class="phero__h1 dsp"><Fragment set:html={t.h1} /></h1>
        <aside class="archive-notice" aria-labelledby="archive-heading" data-keyhop-archived>
          <h2 id="archive-heading">{statusHeading}</h2>
          <a data-hover href={repositoryUrl} lang="en" dir="ltr">GitHub · Archived ↗</a>
        </aside>
        <figure class="hero-film">
          <video id="keyhop-story-video" data-keyhop-hero-video aria-label={film.label} poster={heroVideoPoster}
            preload="metadata" muted loop playsinline controls>
            <source src={heroVideoUrl} type="video/mp4">
            <track kind="captions" src={`/v/keyhop/captions-${filmLocale}-v4.vtt`} srclang={t.htmlLang} label={t.htmlLang} default>
            <img src={heroVideoPoster} alt={film.label}>
          </video>
          <div class="hero-captions" data-keyhop-captions aria-hidden="true" hidden>
            {['chase', 'hop', 'flow', 'tagline'].map((key, index) => <span class="hero-caption" data-caption={key} data-active={index === 0 ? '' : undefined}>{film[key]}</span>)}
          </div>
          <div class="hero-controls" data-keyhop-video-controls hidden>
            <button type="button" data-video-play data-play-label={film.play} data-pause-label={film.pause} aria-label={film.play} aria-controls="keyhop-story-video">
              <svg class="icon-play" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6 3.5v13l10-6.5Z"/></svg>
              <svg class="icon-pause" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5 3h3v14H5zm7 0h3v14h-3Z"/></svg>
            </button>
            <button type="button" data-video-sound data-sound-on-label={film.soundOn} data-sound-off-label={film.soundOff} aria-label={film.soundOn} aria-controls="keyhop-story-video" data-muted>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7h3l4-3v12l-4-3H3Z"/>
                <path class="icon-sound" d="M13 6a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/>
                <path class="icon-muted" d="m14 7 4 6m0-6-4 6"/>
              </svg>
            </button>
          </div>
        </figure>
        <p class="phero__sub"><Fragment set:html={t.sub} /></p>
      </div>
    </section>

    <dl class="deck wrap" data-reveal-group data-stagger="140" data-distance="2.1em" data-start="top 88%">
      {t.cards.map((card, index) => <div class="card card__grid">
        <dt class="card__title dsp"><Fragment set:html={card.title} /></dt>
        <dd class="card__p"><Fragment set:html={card.p} /></dd>
        {index === 0 && <dd class="card__demo">
          <div class="gesture-demo" role="region" aria-label={t.gestureAria}>
            <div class="gesture" role="img" aria-label={t.gestureAria}>
              <div class="gesture__leader" aria-hidden="true">
                <span class="gesture__leader-key" data-demo-clock data-demo-leader>⌥</span>
                <span class="gesture__leader-key" data-demo-leader>⌥</span>
              </div>
              <div class="gesture__matrix" aria-hidden="true">
                {demoApps.map(([name, src], i) => <div class="gesture__binding" data-demo-binding data-active={i === 0 ? '' : undefined}>
                  <img class="gesture__app" src={src} alt={name}>
                  <span class="gesture__slot" data-layout-key>{['A','S','D','F','G','H','J','K','L',';'][i]}</span>
                </div>)}
              </div>
            </div>
            <div class="gesture__controls">
              <span class="gesture__select">
                <select name="leader-modifier" data-modifier-select aria-label={modifierLabel}>
                  <option value="command">⌘ Command</option>
                  <option value="option" selected>⌥ Option</option>
                  <option value="control">⌃ Control</option>
                  <option value="shift">⇧ Shift</option>
                </select>
              </span>
              <span class="gesture__select gesture__select--layout">
                <select id={`keyhop-layout-${code || 'zh'}`} name="keyboard-layout" data-layout-select aria-label={layoutLabel}>
                  <option value="qwerty">QWERTY</option>
                  <option value="dvorak">Dvorak</option>
                  <option value="colemak">Colemak</option>
                  <option value="azerty">AZERTY</option>
                  <option value="qwertz">QWERTZ</option>
                </select>
              </span>
            </div>
          </div>
        </dd>}
      </div>)}
    </dl>

    <section class="pair wrap" data-reveal-group data-stagger="120" data-distance="1.4em" data-start="top 86%">
      <h2 class="pair__h2 dsp"><Fragment set:html={t.compare.h2} /></h2>
      <dl class="pair__grid">
        <div class="pair__cell pair__cell--src"><dt class="mono">{t.compare.beforeLabel}</dt><dd>{t.compare.before}</dd></div>
        <div class="pair__cell pair__cell--out"><dt class="mono">{t.compare.afterLabel}</dt><dd>{t.compare.after}</dd></div>
      </dl>
      <div class="pair__why"><p>{t.compare.why}</p></div>
    </section>

    <section class="pair wrap" data-reveal-group data-stagger="120" data-distance="1.4em" data-start="top 86%">
      <h2 class="pair__h2 dsp"><Fragment set:html={t.setup.h2} /></h2>
      <div class="pair__grid">
        <div class="pair__cell pair__cell--src"><p>{t.setup.first}</p></div>
        <div class="pair__cell pair__cell--out"><p>{t.setup.second}</p></div>
      </div>
    </section>

    <section class="bounds wrap" data-reveal-group data-stagger="120" data-distance="1.4em" data-start="top 86%">
      <h2 class="bounds__h2 dsp"><Fragment set:html={t.bounds.h2} /></h2>
      <p class="phero__sub bounds__note">{t.bounds.note}</p>
      <dl class="bounds__grid">
        {t.bounds.items.map(([q, a]) => <div><dt class="bounds__q">{q}</dt><dd class="bounds__a">{a}</dd></div>)}
      </dl>
    </section>
  </main>

  <footer class="wrap">
