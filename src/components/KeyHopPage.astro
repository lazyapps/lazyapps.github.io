      </div>
      <SiteFooterBase locale={t.htmlLang} pressKit={false} />
    </div>
  </footer>

  <script is:inline src={gsapUrl}></script>
  <script is:inline src={scrollTriggerUrl}></script>
  <script is:inline src={customEaseUrl}></script>
  <script is:inline src={splitTextUrl}></script>
  <script is:inline src={logoRevealUrl}></script>
  <script is:inline src={siteJsUrl}></script>
  <script is:inline>
    (() => {
      const video = document.querySelector('[data-keyhop-hero-video]');
      if (!video) return;
      const captions = document.querySelector('[data-keyhop-captions]');
      const captionItems = captions.querySelectorAll('[data-caption]');
      const nativeCaptions = video.textTracks[0];
      nativeCaptions.mode = 'hidden';
      captions.hidden = false;
      function updateCaption() {
        const time = video.currentTime;
        const key = time < 5 ? 'chase' : time < 10 ? 'hop' : time < 12.7 ? 'flow' : 'tagline';
        captionItems.forEach((caption) => caption.toggleAttribute('data-active', caption.dataset.caption === key));
      }
      nativeCaptions.addEventListener('cuechange', updateCaption);
      ['timeupdate', 'seeked', 'loadedmetadata'].forEach((event) => video.addEventListener(event, updateCaption));
      updateCaption();
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const controls = document.querySelector('[data-keyhop-video-controls]');
      const playButton = controls.querySelector('[data-video-play]');
      const soundButton = controls.querySelector('[data-video-sound]');
      video.controls = false;
      controls.hidden = false;
      let visible = false;
      let userPaused = false;
      let automaticPause = false;

      function updateControls() {
        playButton.setAttribute('aria-label', video.paused ? playButton.dataset.playLabel : playButton.dataset.pauseLabel);
        playButton.toggleAttribute('data-playing', !video.paused);
        soundButton.setAttribute('aria-label', video.muted ? soundButton.dataset.soundOnLabel : soundButton.dataset.soundOffLabel);
        soundButton.toggleAttribute('data-muted', video.muted);
      }
      playButton.addEventListener('click', () => {
        if (video.paused) video.play().catch(() => {});
        else video.pause();
      });
      soundButton.addEventListener('click', () => { video.muted = !video.muted; });
      video.addEventListener('volumechange', updateControls);

      function syncPlayback() {
        if (document.getElementById('loader')) return;
        if (!visible || document.hidden || motion.matches) {
          if (!video.paused) {
            automaticPause = true;
            video.pause();
          }
          return;
        }
        if (!userPaused) video.play().catch(() => {});
      }

      video.addEventListener('pause', () => {
        if (automaticPause) automaticPause = false;
        else userPaused = true;
        updateControls();
      });
      video.addEventListener('play', () => { userPaused = false; updateControls(); });
      updateControls();
      new IntersectionObserver((entries) => {
        visible = entries[0]?.isIntersecting ?? false;
        syncPlayback();
      }, { threshold: 0.2 }).observe(video);
      document.addEventListener('visibilitychange', syncPlayback);
      motion.addEventListener('change', syncPlayback);
      if (document.getElementById('loader')) {
        const loaderObserver = new MutationObserver(() => {
          if (!document.getElementById('loader')) {
            loaderObserver.disconnect();
            syncPlayback();
          }
        });
        loaderObserver.observe(document.body, { childList: true });
      }
    })();
  </script>
  <script is:inline>
    const layouts = {
      qwerty: ['A','S','D','F','G','H','J','K','L',';'],
      dvorak: ['A','O','E','U','I','D','H','T','N','S'],
      colemak: ['A','R','S','T','D','H','N','E','I','O'],
      azerty: ['Q','S','D','F','G','H','J','K','L','M'],
      qwertz: ['A','S','D','F','G','H','J','K','L','Ö'],
    };
    const layoutSelect = document.querySelector('[data-layout-select]');
    layoutSelect?.addEventListener('change', (event) => {
      const labels = layouts[event.currentTarget.value];
      document.querySelectorAll('[data-layout-key]').forEach((key, index) => { key.textContent = labels[index]; });
    });

    const modifiers = { command: '⌘', option: '⌥', control: '⌃', shift: '⇧' };
    document.querySelector('[data-modifier-select]')?.addEventListener('change', (event) => {
      document.querySelectorAll('[data-demo-leader]').forEach((key) => { key.textContent = modifiers[event.currentTarget.value]; });
    });

    const bindings = [...document.querySelectorAll('[data-demo-binding]')];
    let demoIndex = 0;
    document.querySelector('[data-demo-clock]')?.addEventListener('animationiteration', () => {
      bindings[demoIndex].removeAttribute('data-active');
      demoIndex = (demoIndex + 1) % bindings.length;
      bindings[demoIndex].setAttribute('data-active', '');
    });

  </script>
</body>
</html>
