const copy = copies[language] ?? copies.en;
---
<link rel="stylesheet" href="/shheep/game/game.abb65f35a8c45a02.css">
<section class="shheep-game" aria-label="Shheep" lang={language} data-language={language} data-state="loading">
  <div class="game-toolbar">
    <span class="game-night">Shheep</span>
    <div class="game-tools">
      <label class="game-language-label"><span class="sr-only" data-web-copy="languageLabel">{copy.languageLabel}</span>
        <select class="game-language" disabled aria-label={copy.languageLabel}>
          <option value="en" selected={language === "en"}>ENGLISH</option><option value="zh-Hans" selected={language === "zh-Hans"}>简体中文</option><option value="zh-Hant" selected={language === "zh-Hant"}>繁體中文</option><option value="ja" selected={language === "ja"}>日本語</option><option value="ko" selected={language === "ko"}>한국어</option><option value="es" selected={language === "es"}>ESPAÑOL</option><option value="pt-BR" selected={language === "pt-BR"}>PORTUGUÊS</option><option value="de" selected={language === "de"}>DEUTSCH</option><option value="fr" selected={language === "fr"}>FRANÇAIS</option><option value="it" selected={language === "it"}>ITALIANO</option><option value="ru" selected={language === "ru"}>РУССКИЙ</option>
        </select>
      </label>
      <button type="button" class="game-sound" disabled aria-pressed="false" aria-label={copy.soundOff}>{copy.soundOn}</button>
      <button type="button" class="game-pause" hidden aria-label={copy.pause}>Ⅱ</button>
      <button type="button" class="game-expand" disabled aria-pressed="false">{copy.expand}</button>
    </div>
  </div>
  <div class="game-stage">
    <img class="game-placeholder" src="/shheep/preview.png" width="1050" height="560" alt="" fetchpriority="high" decoding="async">
    <canvas tabindex="-1" aria-label={copy.instructions} aria-describedby="game-instructions" width="1200" height="640"></canvas>
    <div class="game-loading" role="status">
      <div class="game-loading__flock" aria-hidden="true">
        <img class="game-loading__fence" src="/shheep/assets/sprites/fence_small1.png" width="26" height="19" alt="">
        <img class="game-loading__sheep" src="/shheep/assets/sprites/sheep_jump.png" width="94" height="80" alt="">
      </div>
      <div class="game-loading__copy"><p class="game-loading__message sr-only">{copy.loading}</p></div>
    </div>
    <button type="button" class="game-start" hidden>{copy.start}</button>
    <button type="button" class="game-resume" hidden>{copy.resumePrompt}</button>
    <div class="game-result" hidden>
      <h2 data-copy="WIDE AWAKE!">{copy.wideAwake}</h2>
      <div class="game-result-card">
        <p class="game-result-count"></p>
        <p class="game-result-best"></p>
        <button type="button" class="game-restart" data-copy="SHH... SLEEP">{copy.sleep}</button>
        <div class="game-result-actions">
          <button type="button" class="game-records">{copy.records}</button>
          <button type="button" class="game-share" data-copy="SHARE">{copy.share}</button>
        </div>
      </div>
    </div>
    <noscript><div class="game-noscript">{copy.noScript}</div></noscript>
  </div>
  <div class="game-controls">
    <p id="game-instructions">{copy.instructions}</p>
    <div class="game-touch-controls">
      <button type="button" class="game-hop" aria-label={copy.hop}>{copy.hop}</button>
      <button type="button" class="game-duck" aria-label={copy.duck}>{copy.duck}</button>
    </div>
  </div>
  <p class="game-status sr-only" role="status" aria-live="polite"></p>
  <dialog class="game-dialog" aria-labelledby="game-dialog-title">
    <div class="game-dialog-head"><h2 id="game-dialog-title">{copy.records}</h2><button type="button" class="game-dialog-close" aria-label={copy.closeDialog}>×</button></div>
    <div class="game-record-content" hidden>
      <dl><div><dt data-web-copy="tonightBest">{copy.tonightBest}</dt><dd class="record-tonight">0</dd></div><div><dt data-web-copy="allTimeBest">{copy.allTimeBest}</dt><dd class="record-best">0</dd></div><div><dt data-web-copy="nightsInRow">{copy.nightsInRow}</dt><dd class="record-streak">0</dd></div></dl>
      <p data-web-copy="recordNote">{copy.recordNote}</p>
    </div>
    <div class="game-share-content" hidden>
      <img class="game-share-preview" alt={copy.sharePreview} width="1080" height="1080">
      <label for="shheep-share-text" data-web-copy="shareMessage">{copy.shareMessage}</label>
      <textarea id="shheep-share-text" readonly rows="6"></textarea>
      <div class="game-share-actions"><a class="game-download" download="shheep-good-night.png" data-web-copy="saveCard">{copy.saveCard}</a><button type="button" class="game-copy" data-web-copy="copyMessage">{copy.copyMessage}</button></div>
      <p class="game-copy-status" role="status"></p>
    </div>
  </dialog>
</section>



{import.meta.env.DEV ? (
<script is:inline type="module">
const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
await import(local && new URLSearchParams(location.search).get('record') === '1' ? '/__dev/shheep-recording.js' : '/shheep/game/game.561e0fbae4532c37.js');
</script>
) : (
<script is:inline type="module" src="/shheep/game/game.561e0fbae4532c37.js"></script>
)}
