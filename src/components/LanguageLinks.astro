---
interface Props {
  label: string;
  current: string;
  links: { language: string; url: string; label: string }[];
}
const { label, current, links } = Astro.props;
---
<details class="language-links">
  <summary>{label}</summary>
  <nav aria-label={label}>
    {links.map(link => <a href={link.url} lang={link.language} hreflang={link.language} aria-current={link.url === current ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</details>
<style>
  .language-links { margin-block: 24px; font: 400 .875rem/1.6 var(--sans); }
  summary { width: fit-content; padding-block: 10px; cursor: pointer; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 20px; padding-block: 8px; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-underline-offset: .2em; }
  a[aria-current] { text-decoration: underline; }
  :is(a, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 2px; }
</style>
