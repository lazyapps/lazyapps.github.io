---
import russianBadge from '$assets/img/shheep/app-store-badge-ru-ru.svg?url';
interface Props { href: string; locale: string; description: string; }
const { href, locale, description } = Astro.props;
const badges = import.meta.glob<string>('/src/assets/img/chmate/app-store-badge-*.svg', { eager: true, query: '?url', import: 'default' });
const badgeLocales: Record<string, string> = {
  en: 'en', 'zh-Hans': 'zh-cn', 'zh-Hant': 'zh-tw', ja: 'ja-jp', ko: 'ko-kr',
  es: 'es-es', 'pt-BR': 'pt-br', de: 'de-de', fr: 'fr-fr', it: 'it-it',
};
const badgeUrl = locale === 'ru' ? russianBadge : badges[`/src/assets/img/chmate/app-store-badge-${badgeLocales[locale]}.svg`];
---
<a class="app-store-badge" href={href}>
  <img src={badgeUrl} height="48" alt={description}>
</a>
