---
import favicon16 from '$assets/img/calmon-favicon/favicon-16.png?url';
import favicon32 from '$assets/img/calmon-favicon/favicon-32.png?url';
import faviconIco from '$assets/img/calmon-favicon/favicon.ico?url';
import faviconDark16 from '$assets/img/calmon-favicon/favicon-dark-16.png?url';
import faviconDark32 from '$assets/img/calmon-favicon/favicon-dark-32.png?url';
import faviconDarkIco from '$assets/img/calmon-favicon/favicon-dark.ico?url';
---
<link rel="icon" type="image/x-icon" sizes="16x16 32x32" href={faviconIco}>
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href={favicon16}>
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href={favicon32}>
<link rel="icon" type="image/x-icon" sizes="16x16 32x32" media="(prefers-color-scheme: dark)" href={faviconDarkIco}>
<link rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)" href={faviconDark16}>
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href={faviconDark32}>
