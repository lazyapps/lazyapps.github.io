---
import { statSync } from 'node:fs';
import { getImage } from 'astro:assets';
import '../assets/s/site-footer.css';
import { languageHash } from '../i18n/presskit-language.mjs';
import landscape from '../assets/img/footer-landscape.png';
interface Props {
  class?: string;
  locale?: string;
  pressKit?: string | false;
}

const { class: className, locale = 'en', pressKit = '/presskit/' } = Astro.props;
const classes = ['base', className].filter(Boolean).join(' ');
const privacyUrl = locale.toLowerCase().startsWith('zh') ? '/privacy.zh.html' : '/privacy.en.html';
const pressKitUrl = pressKit && pressKit.split('#')[0] + languageHash(locale === 'zh' ? 'zh-Hans' : locale);

const macApps = [
  { name: 'Doze', href: '/doze/' },
  { name: 'YiYan', href: '/yiyan/' },
  { name: 'XVDL', href: '/xvdl/' },
];
const mobileApps = [
  { name: 'Shheep', href: '/shheep/' },
  { name: 'CHMate', href: '/chmate/' },
  { name: 'World Book', href: '/world-book/' },
  { name: 'FondFont', href: '/fondfont/' },
];

// One seamless tile, repeated across the full width of the footer band.
// AVIF for browsers that can pick by type, WebP otherwise; both at 1x and 2x.
const tileWidths = [Math.round(landscape.width / 2), landscape.width];
const [avif1x, avif2x, webp1x, webp2x] = await Promise.all([
  ...tileWidths.map(width => getImage({ src: landscape, width, format: 'avif', quality: 50 })),
  ...tileWidths.map(width => getImage({ src: landscape, width, format: 'webp', quality: 75 })),
]);
// Dev serves /_image with a one-year max-age under an unchanged URL, so version it by mtime; build URLs are content-hashed.
const devVersion = import.meta.env.DEV ? `&v=${Math.round(statSync(new URL('../assets/img/footer-landscape.png', import.meta.url)).mtimeMs)}` : '';
const tile = (image: { src: string }, density: string, type?: string) =>
  `url("${image.src}${devVersion}")${type ? ` type("image/${type}")` : ''} ${density}`;
const landStyle = [
  `--tile-ratio:${landscape.width / landscape.height}`,
  `--land:image-set(${tile(webp1x, '1x')},${tile(webp2x, '2x')})`,
  `--land-typed:image-set(${tile(avif1x, '1x', 'avif')},${tile(avif2x, '2x', 'avif')},${tile(webp1x, '1x', 'webp')},${tile(webp2x, '2x', 'webp')})`,
].join(';');
---

<div id="site-footer" class={classes} lang="en" dir="ltr">
  <div class="base__panel">
    <div class="base__inner">
      <div class="base__top">
        <div class="base__brand">
          <a href="/" class="base__wordmark" aria-label="lazyapps home" data-press-home>Lazyapps<i aria-hidden="true"></i></a>
          <p class="base__meta">© 2026 · Taking it easy since 2009</p>
        </div>
        <div class="base__cols">
          <nav class="base__col" aria-label="Mac apps">
            <p class="base__label">Mac</p>
            <ul>
              {macApps.map(app => <li><a data-hover href={app.href}><span data-underline-link class="underline-link">{app.name}</span></a></li>)}
            </ul>
          </nav>
          <nav class="base__col" aria-label="iPhone and iPad apps">
            <p class="base__label">iPhone &amp; iPad</p>
            <ul>
              {mobileApps.map(app => <li><a data-hover href={app.href}><span data-underline-link class="underline-link">{app.name}</span></a></li>)}
            </ul>
          </nav>
          <nav class="base__col" aria-label="Footer" data-press-footer-nav>
            <p class="base__label">Studio</p>
            <ul>
              <li><a data-hover href="/support/"><span data-underline-link class="underline-link" data-press-text="support">Support</span></a></li>
              {pressKit && <li><a data-hover href={pressKitUrl} data-press-route={pressKit.split('#')[0]}><span data-underline-link class="underline-link" data-press-text="kit">Press Kit</span></a></li>}
              <li><a data-hover href={privacyUrl} data-press-privacy><span data-underline-link class="underline-link" data-press-text="privacy">Privacy</span></a></li>
            </ul>
          </nav>
        </div>
      </div>
    </div>

    <div class="base__scene" aria-hidden="true" style={landStyle}>
      <span class="base__sun">
        <svg class="base__face" viewBox="0 0 64 64" fill="none" focusable="false">
          <path class="base__sun-rays" d="M32 3v5m0 48v5M3 32h5m48 0h5M11.5 11.5l3.5 3.5m34 34 3.5 3.5m-41 0L15 49m34-34 3.5-3.5" stroke="var(--sun-color)" stroke-width="3" stroke-linecap="round" />
          <circle cx="32" cy="32" r="19.5" fill="var(--sun-color)" />
          <path class="base__eyes-sleepy" d="M23 30q3 3 6 0m6 0q3 3 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <g class="base__eyes-awake" fill="currentColor"><circle cx="26" cy="30" r="2.2" /><circle cx="38" cy="30" r="2.2" /></g>
          <path d="M28 39q4 3 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>
      <div class="base__land"></div>
      <noscript><style is:inline>.base__land{background-image:var(--land)}</style></noscript>
      <span class="base__zzz"><i>z</i><i>z</i><i>z</i></span>
    </div>
  </div>
</div>

<script>
  const footer = document.getElementById('site-footer');
  const scene = footer?.querySelector<HTMLElement>('.base__scene');
  if (footer && scene) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const HILLTOP = 0.34; // where the hills start in the tile, as a fraction of its height
    const root = document.documentElement;
    let inView = false;
    let frame = 0;
    // rise: 0 while the landscape is below the fold, 1 once it has fully come into view.
    let riseTarget = 1;
    let rise = 1;
    // pull: extra scrolling past the end of the page, rubber-banded to 0…1.
    let overscroll = 0;
    let pull = 0;
    let lastInput = 0;
    let touchY: number | null = null;
    let touchBase = 0;

    const atBottom = () => window.innerHeight + window.scrollY >= root.scrollHeight - 2;
    const measure = () => {
      // 0 when the hills come into view, 1 at the very bottom of the meadow: the sun rises as you keep scrolling.
      const rect = scene.getBoundingClientRect();
      const hills = rect.top + rect.height * HILLTOP;
      riseTarget = Math.min(1, Math.max(0, (window.innerHeight - hills) / (rect.bottom - hills)));
    };
    const tick = (now: number) => {
      frame = 0;
      rise += (riseTarget - rise) * 0.09;
      if (Math.abs(riseTarget - rise) < 0.0005) rise = riseTarget;
      // Let go once the wheel or finger has been still for a moment, then ease back.
      if (touchY === null && now - lastInput > 140) {
        overscroll *= 0.88;
        if (overscroll < 0.5) overscroll = 0;
      }
      const pullTarget = 1 - 1 / (1 + overscroll / 420);
      pull += (pullTarget - pull) * 0.18;
      if (Math.abs(pullTarget - pull) < 0.0005) pull = pullTarget;
      footer.style.setProperty('--rise', rise.toFixed(4));
      footer.style.setProperty('--pull', pull.toFixed(4));
      footer.toggleAttribute('data-awake', pull > 0.5);
      if (rise !== riseTarget || pull !== pullTarget || overscroll > 0) frame = requestAnimationFrame(tick);
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };
    const onScroll = () => {
      measure();
      if (!atBottom()) overscroll = 0;
      schedule();
    };
    const onWheel = (event: WheelEvent) => {
      if (!atBottom()) return;
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? window.innerHeight : 1;
      overscroll = Math.min(2400, Math.max(0, overscroll + event.deltaY * unit));
      lastInput = performance.now();
      schedule();
    };
    const onTouchStart = (event: TouchEvent) => {
      touchY = event.touches[0].clientY;
      touchBase = overscroll;
    };
    const onTouchMove = (event: TouchEvent) => {
      if (touchY === null) return;
      if (!atBottom()) {
        touchY = event.touches[0].clientY;
        return;
      }
      overscroll = Math.min(2400, Math.max(0, touchBase + (touchY - event.touches[0].clientY) * 1.6));
      lastInput = performance.now();
      schedule();
    };
    const onTouchEnd = () => {
      touchY = null;
      schedule();
    };
    const listeners: [EventTarget, string, EventListener][] = [
      [window, 'scroll', onScroll as EventListener],
      [window, 'resize', onScroll as EventListener],
      [window, 'wheel', onWheel as EventListener],
      [window, 'touchstart', onTouchStart as EventListener],
      [window, 'touchmove', onTouchMove as EventListener],
      [window, 'touchend', onTouchEnd as EventListener],
      [window, 'touchcancel', onTouchEnd as EventListener],
    ];
    let listening = false;
    const update = () => {
      const visible = inView && !document.hidden;
      const active = visible && !reduce.matches;
      footer.toggleAttribute('data-animating', visible);
      if (active && !listening) {
        listeners.forEach(([target, type, fn]) => target.addEventListener(type, fn, { passive: true }));
        listening = true;
        onScroll();
      } else if (!active && listening) {
        listeners.forEach(([target, type, fn]) => target.removeEventListener(type, fn));
        listening = false;
        overscroll = 0;
        touchY = null;
        schedule();
      }
      if (reduce.matches) {
        cancelAnimationFrame(frame);
        frame = 0;
        riseTarget = rise = 1;
        overscroll = pull = 0;
        footer.style.setProperty('--rise', '1');
        footer.style.setProperty('--pull', '0');
        footer.removeAttribute('data-awake');
      }
    };

    // Start lowered so the first reveal plays; settle instantly if the footer is already on screen.
    measure();
    rise = reduce.matches ? 1 : riseTarget;
    footer.style.setProperty('--rise', rise.toFixed(4));
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      update();
    }).observe(scene);
    // Fetch the artwork only when the footer is about a screen away, so it never competes with the page itself.
    const landObserver = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      footer.setAttribute('data-land', '');
      landObserver.disconnect();
    }, { rootMargin: '0px 0px 100% 0px' });
    landObserver.observe(scene);
    document.addEventListener('visibilitychange', update);
    reduce.addEventListener('change', update);
  }
</script>
