---
import SocialMeta from '../components/SocialMeta.astro';
import StructuredData from '../components/StructuredData.astro';
// App Store launch: restore the native app metadata and download badge below.
// import SoftwareApplication from '../components/SoftwareApplication.astro';
import SiteFooterBase from '../components/SiteFooterBase.astro';
import ShheepGame from '../components/ShheepGame.astro';
import chromiumLicense from '../../public/shheep/assets/CHROMIUM-LICENSE.txt?raw';
import silkscreenLicense from '../../public/shheep/assets/fonts/OFL.txt?raw';
import fusionPixelLicense from '../../public/shheep/assets/fonts/FusionPixel-OFL.txt?raw';
import tiny5License from '../../public/shheep/assets/fonts/Tiny5-OFL.txt?raw';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
const art = '/shheep/assets/sprites/';
// const appStoreCampaign = 'pt=259198&ct=lazyapps-en&mt=8';
// const storeURL = `https://apps.apple.com/app/apple-store/id6819031865?${appStoreCampaign}`;
const title = 'Shheep — Play the Cozy Pixel Sheep Game';
const description = 'Hop over fences, duck under bats and count sheep in a cozy pixel dream. Play Shheep in your browser. Coming soon to iPhone and iPad.';
const pageURL = 'https://lazyapps.com/shheep/';
const fontNotices = [
  { name: 'Silkscreen', license: silkscreenLicense, href: '/shheep/assets/fonts/OFL.txt' },
  { name: 'Fusion Pixel', license: fusionPixelLicense, href: '/shheep/assets/fonts/FusionPixel-OFL.txt' },
  { name: 'Tiny5', license: tiny5License, href: '/shheep/assets/fonts/Tiny5-OFL.txt' },
].map(font => ({ ...font, copyright: font.license.split('\n').find(line => line.startsWith('Copyright')) }));
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#171717" data-page-color="#f8f8f6">
  {/* <meta name="apple-itunes-app" content={`app-id=6819031865, affiliate-data=${appStoreCampaign}`}> */}
  <SocialMeta title={title} description={description}
    url={pageURL} image="https://lazyapps.com/shheep/opengraph.png"
    imageAlt="Shheep’s pink pixel sheep wordmark above a sleeping girl in a cozy purple bedroom" imageWidth={1200} imageHeight={630} locale="en_US" />
  {/* <SoftwareApplication name="Shheep" description={description} url={pageURL}
    language="en" operatingSystem="iOS, iPadOS" applicationCategory="GameApplication"
    downloadUrl={storeURL} image="https://lazyapps.com/shheep/opengraph.png" /> */}
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${pageURL}#game`,
    name: 'Shheep', description, url: pageURL, inLanguage: 'en',
    applicationCategory: 'GameApplication', operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript and HTML5 canvas support.',
    image: 'https://lazyapps.com/shheep/opengraph.png',
    publisher: { '@type': 'Organization', name: 'lazyapps', url: 'https://lazyapps.com/' },
  }} />
  <link rel="icon" type="image/png" href={`${art}sheep_run1.png`}>
  <link rel="stylesheet" href={siteCssUrl}>
  <script is:inline>
    document.documentElement.classList.remove('no-js');
    setTimeout(() => {
      document.documentElement.classList.add('is-page-theme', 'is-loaded');
      document.getElementById('loader')?.remove();
      document.querySelectorAll('meta[name="theme-color"][data-page-color]').forEach((meta) => {
        meta.setAttribute('content', meta.getAttribute('data-page-color'));
      });
    }, 6000);
  </script>
</head>
<body>
  <a class="skip-link" href="#how-to-play">Skip game to how to play</a>
  <div class="grain" aria-hidden="true"></div>
  <div data-load-wrap class="loader" id="loader" aria-hidden="true">
    <div data-load-bg class="loader__bg"><div data-load-progress class="loader__bg-bar"></div></div>
    <div data-load-container class="loader__container">
      <div class="loader__logo-wrap">
        <div class="loader__logo-item is--base"><span class="loader__logo-img" lang="en">SHHEEP</span></div>
        <div data-load-logo class="loader__logo-item is--top"><span class="loader__logo-img" lang="en">SHHEEP</span></div>
      </div>
    </div>
  </div>
  <main>
    <section class="phero wrap" aria-labelledby="shheep-title">
      <div class="topbar">
        <nav class="mono topbar__nav" aria-label="Primary"><a href="/" class="topbar__home" aria-label="lazyapps home"><span aria-hidden="true" class="topbar__home-dot"></span></a></nav>
        <div class="topbar__app"><img src={`${art}sheep_run1.png`} width="47" height="40" alt=""><span class="dsp">Shheep</span></div>
        <a class="mono hero-how" href="#how-to-play">How to play ↘</a>
      </div>
      <h1 class="phero__h1 dsp" id="shheep-title"><span class="sr-only">Shheep — </span>One more sheep.<br>A little more sleep.</h1>
      <p class="phero__sub">She can’t sleep. You know what to do.</p>
      <ShheepGame />
      <div class="phero__cta">
        {/* <a href={storeURL} class="app-store-badge">
          <img src="/shheep/app-store-badge.svg" width="144" height="48" alt="Download on the App Store">
        </a> */}
        <span class="app-store-badge">
          <img src="/shheep/app-store-coming-soon.svg" width="144" height="48" alt="Coming soon on the App Store">
        </span>
      </div>
    </section>

    <section class="deck wrap" id="how-to-play" tabindex="-1" aria-label="How to play Shheep">
      <div data-reveal-group data-stagger="140" data-distance="1.5em" data-start="top 92%">
        <article class="dream-card dream-card--pink">
          <div class="dream-card__grid">
            <div><h2 class="dream-card__title dsp">Count sheep.<br>Keep her dreaming.</h2><p>Hop over a fence and she counts one more sheep. Hold a little longer to jump a little higher. When a bat flies by, duck down—or hop over it if it’s low.</p></div>
            <div class="dream-card__scene dream-card__scene--hop" aria-hidden="true"><img class="scene-star" src={`${art}fx_sparkle.png`} loading="lazy" alt=""><img class="scene-sheep" src={`${art}sheep_jump.png`} loading="lazy" alt=""><img class="scene-fence" src={`${art}fence_small1.png`} loading="lazy" alt=""><span class="scene-plus">+1</span><div class="scene-meadow"></div></div>
          </div>
        </article>
        <article class="dream-card dream-card--lilac">
          <div class="dream-card__grid">
            <div><h2 class="dream-card__title dsp">Same night.<br>Same little flock.</h2><p>A new course for every night. Come back for the same fences and bats, try to count a few more, and keep your nightly streak going. Past midnight? It’s still the same night until noon.</p></div>
            <div class="dream-card__scene dream-card__scene--night" aria-hidden="true"><img src={`${art}moon_crescent.png`} class="scene-moon" loading="lazy" alt=""><img src={`${art}cloudtown.png`} class="scene-town" loading="lazy" alt=""><img src={`${art}cloudsea_front.png`} class="scene-cloud" loading="lazy" alt=""><span class="scene-night">GOOD NIGHT</span></div>
          </div>
        </article>
        <article class="dream-card dream-card--ink">
          <div class="dream-card__grid">
            <div><h2 class="dream-card__title dsp">Oops.<br>She’s wide awake.</h2><p>One bump and the dream falls apart. She cries. She pounds the bed. The bed loses. Tuck her back in and try again—or send a little good-night card with the sheep you counted.</p></div>
            <div class="dream-card__scene dream-card__scene--wake" aria-hidden="true"><img src={`${art}bed_sob0.png`} loading="lazy" alt=""><span>WAAAH!</span></div>
          </div>
        </article>
      </div>
    </section>

    <section class="details wrap" aria-labelledby="details-title">
      <p class="mono">Small enough for one more try</p>
      <h2 class="dsp" id="details-title">A tiny bedtime ritual.</h2>
      <dl class="details__grid">
        <div><dt>Made for a quiet moment</dt><dd>A pixel bedroom, a floating meadow and a looping lullaby. Sound starts when you play, and you can mute it whenever you like.</dd></div>
        <div><dt>Play your way</dt><dd>Tap or press Space to hop; swipe down or hold ↓ to duck. Use the on-screen controls on a phone. P or Esc pauses; Expand gives the dream more room.</dd></div>
        <div><dt>Eleven ways to say good night</dt><dd>English, 简体中文, 繁體中文, 日本語, 한국어, Español, Português, Deutsch, Français, Italiano and Русский. Choose your game language above.</dd></div>
        <div><dt>Your flock stays with you</dt><dd>Web scores and streaks are saved in this browser. The iOS app adds Game Center leaderboards, friend challenges and invitations. Web and iOS records don’t sync.</dd></div>
      </dl>
    </section>
  </main>
  <footer class="wrap shheep-footer">
    <section class="next">
      <img class="footer-sheep" src={`${art}sheep_blink.png`} width="47" height="40" loading="lazy" alt="A sleepy little sheep">
      <h2 class="next__q dsp">Sleep can wait.<br>One more sheep?</h2>
      <div class="next__act"><a href="#shheep-title" class="button-023 button-023--square">
        <span class="button-023__bg"><span style="--index:0" class="button-023__bg-inner is--first"></span><span style="--index:1" class="button-023__bg-inner is--second"></span></span>
        <span class="button-023__inner"><span class="button-023__text is--first">Back to the dream ↑</span><span aria-hidden="true" class="button-023__text is--second">Back to the dream ↑</span></span>
      </a></div>
      <p class="footer-credits"><a href="/shheep/assets/MUSIC-CREDITS.md">Happy Lullaby by cynicmusic · CC0</a><span aria-hidden="true"> · </span><button type="button" id="licenses-toggle" aria-expanded="false" aria-controls="licenses">Licenses</button></p>
      <div class="licenses" id="licenses" hidden>
        <div class="licenses__content">
          <h3>Chromium Dino</h3>
          <p>Portions of Shheep’s game logic are adapted from Chromium’s Dino game.</p>
          <pre>{chromiumLicense}</pre>
          <h3>Fonts &amp; music</h3>
          {fontNotices.map(font => <p><a href={font.href}>{font.name}</a> — SIL Open Font License 1.1.<br />{font.copyright}</p>)}
          <p>Happy Lullaby (song17) by cynicmusic · CC0. <a href="/shheep/assets/MUSIC-CREDITS.md">Music details</a>.</p>
        </div>
      </div>
      <noscript><p class="footer-credits">Game licenses: <a href="/shheep/assets/CHROMIUM-LICENSE.txt">Chromium</a>{fontNotices.map(font => <Fragment> · <a href={font.href}>{font.name}</a></Fragment>)}</p></noscript>
    </section>
    <SiteFooterBase />
  </footer>
  <script is:inline>
    document.getElementById('licenses-toggle').addEventListener('click', (event) => {
      const button = event.currentTarget;
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(expanded));
      document.getElementById('licenses').hidden = !expanded;
    });
  </script>
  <script is:inline src={gsapUrl}></script>
  <script is:inline src={scrollTriggerUrl}></script>
  <script is:inline src={customEaseUrl}></script>
  <script is:inline src={splitTextUrl}></script>
  <script is:inline src={logoRevealUrl}></script>
  <script is:inline src={siteJsUrl}></script>
</body>
</html>
<style is:global>
  #loader{z-index:10001}
  html[data-shheep-recording="true"],html[data-shheep-recording="true"] *{cursor:none!important}
  html[data-shheep-recording="true"] astro-dev-toolbar{display:none!important}
  .skip-link{position:fixed;top:12px;left:12px;z-index:1000;padding:12px 18px;background:var(--ink);color:var(--paper);border-radius:8px;transform:translateY(calc(-100% - 24px))}
  .skip-link:focus{transform:translateY(0)}
  .phero{padding-top:clamp(8px,1.5vw,18px)}
  .phero .topbar__app img{image-rendering:pixelated;object-fit:contain}
  .phero .topbar__app .dsp{font-size:30px}
  .hero-how{justify-self:end;white-space:nowrap;font-size:10px}
  .phero__h1{margin:clamp(28px,4vw,56px) auto 0;font-size:clamp(48px,7.3vw,104px);text-align:center;max-width:11em}
  .phero__sub{margin:22px auto 0;font-size:1.0625rem;color:var(--muted);text-align:center;text-wrap:balance}
  .phero__cta{display:flex;justify-content:center;margin-top:24px}
  .app-store-badge{display:inline-block;border-radius:7px}
  .app-store-badge img{display:block;width:auto;height:48px}
  .app-store-badge:focus-visible{outline:2px solid var(--ink);outline-offset:5px}
  .deck{padding-top:var(--space-section)}
  .dream-card{position:relative;padding:var(--space-card);background:var(--fill);border:1px solid #17171714;border-radius:var(--r-card);margin-top:-8px}
  .dream-card:nth-child(odd){transform:rotate(-2deg)}.dream-card:nth-child(even){transform:rotate(2deg)}
  .dream-card--pink{--fill:#ffd4e5}.dream-card--lilac{--fill:#d6c9ee}.dream-card--ink{--fill:#30263c;color:#fff5ed}
  .dream-card__grid{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:var(--space-grid)}
  .dream-card__title{font-size:clamp(36px,4vw,60px);margin-bottom:20px}
  .dream-card__grid p{font-size:1rem;line-height:1.85;max-width:31em}
  .dream-card__scene{position:relative;min-height:230px;overflow:hidden;image-rendering:pixelated}
  .dream-card__scene img{image-rendering:pixelated;position:absolute}
  .scene-sheep{width:141px;left:22%;top:17%}.scene-fence{width:78px;left:49%;bottom:32px}.scene-star{width:24px;top:4%;left:63%}
  .scene-plus{position:absolute;left:58%;top:12%;font:26px ShheepLatin,var(--mono);color:#aa3d79}
  .scene-meadow{position:absolute;bottom:8px;left:6%;right:6%;height:33px;background:url('/shheep/assets/sprites/meadow.png') repeat-x bottom/456px 33px}
  .scene-moon{width:68px;right:14%;top:0}.scene-town{width:100%;bottom:24px}.scene-cloud{width:100%;bottom:-4px;max-height:80px}
  .scene-night{position:absolute;left:7%;top:12%;font:15px ShheepLatin,var(--mono);color:#4a2e5e}
  .dream-card__scene--wake img{width:226px;right:10%;bottom:0}.dream-card__scene--wake span{position:absolute;left:12%;top:12%;color:#9ed1ff;font:22px ShheepLatin,var(--mono);transform:rotate(-8deg)}
  .details{padding-top:var(--space-section)}.details>h2{font-size:clamp(38px,5vw,70px);margin-top:18px}
  .details__grid{display:grid;grid-template-columns:1fr 1fr;gap:32px 48px;margin-top:36px}
  .details__grid dt{font-weight:600;margin-bottom:10px;font-size:1.0625rem}.details__grid dd{font-size:.9375rem;line-height:1.8;color:var(--muted)}
  .shheep-footer{margin-top:var(--space-section)}.footer-sheep{width:94px;height:80px;image-rendering:pixelated;margin:0 auto 24px}
  .licenses{grid-column:1/-1;width:100%;max-width:680px;margin:10px auto 0;color:var(--muted);font:13px/1.7 var(--sans);text-align:left}
  .licenses[hidden]{display:none}
  #licenses-toggle{font:inherit;text-transform:inherit;letter-spacing:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
  #licenses-toggle:hover{text-decoration:underline}
  #licenses-toggle:focus-visible{outline:2px solid var(--ink);outline-offset:5px;border-radius:2px}
  .licenses__content{margin-top:20px;padding-top:20px;border-top:1px solid var(--line)}
  .licenses h3{font:600 14px/1.5 var(--sans);color:var(--ink);margin:0 0 10px}
  .licenses pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:16px 0 24px}
  .licenses__content p+p{margin-top:8px}
  .licenses__content a{text-decoration:underline;text-underline-offset:3px}
  .footer-credits{grid-column:1/-1;justify-self:center;max-width:68ch;font:400 .6667rem/1.4 var(--sans);text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-top:28px;text-align:center}.footer-credits a:hover{text-decoration:underline}
  @media(max-width:700px){.dream-card__grid{grid-template-columns:1fr}.dream-card__scene{min-height:210px}.details__grid{grid-template-columns:1fr}.hero-how{display:none}.phero__h1{font-size:clamp(44px,9vw,66px)}.dream-card__scene--wake img{right:20%}}
</style>
