---
import siteCssUrl from '$assets/s/site.css?url';
import opengraphUrl from '$assets/img/opengraph.png?url';
import SocialMeta from '../../components/SocialMeta.astro';
import SiteGrain from '../../components/SiteGrain.astro';
import SiteEdges from '../../components/SiteEdges.astro';
import SiteFooterBase from '../../components/SiteFooterBase.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const title = 'lazyapps — Support';
const description = 'Get help with CHMate and other lazyapps apps. Contact us by email with questions, bug reports, or feedback.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#f8f8f6">
    <SocialMeta title={title} description={description} url="https://lazyapps.com/support/" image={`https://lazyapps.com${opengraphUrl}`} imageAlt="lazyapps" imageWidth={1200} imageHeight={630} locale="en_US" />
    <link rel="stylesheet" href={siteCssUrl}>
  </head>
  <body>
    <SiteEdges />
    <SiteGrain />
    <a class="support-skip" href="#main">Skip to content</a>
    <SiteHeader class="wrap" />
    <main id="main" class="support wrap">
      <div class="support__content">
        <h1 class="support__title dsp">Support</h1>
        <p class="support__intro">Questions, bug reports, or feedback about CHMate or any other lazyapps app? Email us.</p>
        <a class="support__email" href="mailto:lazyapps.feedback@gmail.com">lazyapps.feedback@gmail.com<span aria-hidden="true">↗</span></a>
        <p class="support__details">For help with an issue, please include the app name, your device and OS version, and a brief description of what happened. Screenshots are welcome.</p>
      </div>
    </main>
    <footer class="wrap"><SiteFooterBase /></footer>
  </body>
</html>
<style>
  body{display:flex;flex-direction:column;min-height:100svh}
  body > :global(.wrap){width:100%}
  .support{flex:1;padding-block:clamp(48px,8vw,112px)}
  .support__content{max-width:760px;text-align:start}
  footer :global(.base__legal){margin-inline:0}
  .support__title{font-size:clamp(64px,9vw,112px);line-height:var(--leading-display);text-transform:uppercase;text-align:start}
  .support__intro{max-width:48ch;margin-top:24px;font-size:20px;line-height:1.6;text-wrap:pretty}
  .support__email{display:inline-flex;align-items:center;gap:12px;min-height:44px;max-width:100%;margin-top:28px;padding-block:8px;font:600 clamp(18px,3vw,30px)/1.5 var(--sans);letter-spacing:-.025em;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em;overflow-wrap:anywhere;touch-action:manipulation}
  .support__email span{flex:none;font-weight:400}
  .support__email:focus-visible{outline:2px solid var(--ink);outline-offset:5px;border-radius:2px}
  .support__details{max-width:58ch;margin-top:24px;font-size:16px;line-height:1.65;color:var(--muted);text-wrap:pretty}
  .support-skip{position:fixed;inset-block-start:8px;inset-inline-start:20px;z-index:1101;padding:10px 14px;background:var(--ink);color:var(--paper);transform:translateY(-200%)}
  .support-skip:focus{transform:none}
  @media(hover:hover) and (pointer:fine){.support__email:hover{text-decoration-thickness:2px}}
  @media(max-width:650px){.support__intro{font-size:18px}.support__email{gap:8px}.support__details{font-size:15px}}
</style>
