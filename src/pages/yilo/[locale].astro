---
import { YILO_LOCALES } from '../../i18n/yilo-locales.mjs';
import YiloPage from '../../components/YiloPage.astro';

export function getStaticPaths() {
  return Object.keys(YILO_LOCALES)
    .filter((code) => code !== '')
    .map((code) => ({ params: { locale: code } }));
}

const t = YILO_LOCALES[Astro.params.locale];
---
<YiloPage t={t} code={Astro.params.locale} />