---
import { CALMON_LOCALES } from '../../i18n/calmon-locales.mjs';
import CalmonPage from '../../components/CalmonPage.astro';
export function getStaticPaths() {
  return Object.keys(CALMON_LOCALES).filter(Boolean).map(locale => ({ params: { locale } }));
}
---
<CalmonPage code={Astro.params.locale} />
