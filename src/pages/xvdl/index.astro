---
const SITE = 'https://lazyapps.com';
import SocialMeta from '../../components/SocialMeta.astro';
import SiteFooterBase from '../../components/SiteFooterBase.astro';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
import iconLargeUrl from '$assets/img/xvdl-icon-large.png?url';
import inUseUrl from '$assets/img/xvdl-in-use.png?url';
import xvdlOpengraphUrl from '$assets/img/xvdl-opengraph.png?url';
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>XVDL — Safari video downloader for X</title>
<meta name="description" content="Download videos directly on X in Safari. XVDL saves the highest-quality available MP4 straight to your Downloads folder—no link copying, converter websites, or media uploads.">
<meta name="theme-color" content="#171717" data-page-color="#e8e8e6">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" data-page-color="#e8e8e6">
<SocialMeta
  title="XVDL — Safari video downloader for X"
  description="Save X videos directly to your Mac in Safari. Straight to your Downloads folder—never through lazyapps servers."
  url={`${SITE}/xvdl/`}
  image={`${SITE}${xvdlOpengraphUrl}`}
  imageAlt="XVDL — Safari video downloader for X"
  imageWidth={1200}
  imageHeight={630}
  locale="en_US"
/>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2215%22%20fill%3D%22%23171717%22%2F%3E%3Cpath%20fill%3D%22%23f8f8f6%22%20d%3D%22M20%2013h12v33h17v10H20z%22%2F%3E%3Ccircle%20cx%3D%2245%22%20cy%3D%2219%22%20r%3D%225%22%20fill%3D%22%23ff6846%22%2F%3E%3C%2Fsvg%3E">
<link rel="stylesheet" href={siteCssUrl}>

<script is:inline>
document.documentElement.classList.remove('no-js');
setTimeout(function(){
  document.documentElement.classList.add('is-page-theme');
  document.documentElement.classList.add('is-loaded');
  var l = document.getElementById('loader');
  if (l) l.remove();
  document.querySelectorAll('meta[name="theme-color"][data-page-color]').forEach(function(meta){
    meta.setAttribute('content', meta.getAttribute('data-page-color'));
  });
}, 6000);
</script>
<style is:inline>
section.phero.wrap{padding-top:clamp(8px,1.5vw,18px);--h1-size:clamp(38px,6.2vw,96px)}
.phero__h1{margin:clamp(28px,4vw,64px) auto 0;font-size:var(--h1-size);max-width:calc(13 * var(--h1-size));text-align:center}
.phero__sub{margin:clamp(18px,2.2vw,32px) auto 0;font-size:1rem;color:var(--muted);max-width:42rem;text-align:center;text-wrap:balance}
.phero__cta{margin-top:clamp(22px,2.6vw,38px);display:flex;justify-content:center;gap:.75rem;flex-wrap:wrap}
.phero__trust{margin-top:clamp(18px,2vw,28px);display:grid;justify-content:center;gap:.5rem;margin-bottom:0;padding:0;list-style:none}
.phero__trust li{display:flex;align-items:center;gap:.6em;font:400 .6875rem/1.4 var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
.phero__trust svg{width:14px;height:14px;color:var(--accent);flex:none}

.shot{
  margin-top:clamp(28px,4vw,60px);
  outline:1px solid rgba(23,23,23,.1);outline-offset:-1px;border-radius:min(3vw,24px);
  background:#fff;overflow:hidden;
}
.shot img{width:100%;height:auto}

.deck{padding-top:clamp(40px,5.5vw,88px);padding-bottom:clamp(32px,4vw,64px)}
.card{
  position:relative;display:block;
  background:var(--fill);color:var(--fg,var(--ink));
  border:1px solid rgba(23,23,23,.08);border-radius:var(--r-card);
  padding:clamp(20px,2.4vw,34px);
  margin-top:-8px;
}
.card:first-child{margin-top:0}
.card--c3{--fill:var(--c3)}
.card--c4{--fill:var(--c4)}
.card--c6{--fill:var(--c6);--fg:#f8f8f6}
.card:nth-child(odd){transform:rotate(-2deg)}
.card:nth-child(even){transform:rotate(2deg)}
.card--ink{border-color:rgba(248,248,246,.12)}
.card__tag{position:absolute;z-index:2;top:clamp(16px,2vw,26px);right:clamp(18px,2.2vw,30px);
  font:400 .6875rem/1.4 var(--mono);text-transform:uppercase;letter-spacing:.09em;opacity:.62}
.card__grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(18px,2.6vw,44px);align-items:start;padding-top:1.5rem}
.card__title{font-size:clamp(26px,3.4vw,46px)}
.card__body{display:grid;gap:clamp(14px,1.6vw,22px)}
.card__p{font-size:1.0625rem;line-height:1.85}
.card__steps{margin:0;padding:0;list-style:none;display:grid;gap:.625rem}
.card__steps li{display:flex;gap:.7em;font-size:1.0625rem;line-height:1.75}
.card__steps svg{width:15px;height:15px;flex:none;margin-top:.4em}
@media (max-width:860px){.card__grid{grid-template-columns:1fr}}

.brew{
  margin-top:clamp(28px,3.5vw,56px);
  border:1px solid rgba(23,23,23,.12);border-radius:var(--r-card);
  background:var(--ink);color:var(--paper);
  padding:clamp(20px,2.4vw,34px);display:grid;gap:1rem;min-width:0;
}
.brew>*{min-width:0}
.brew pre{
  margin:0;font:400 .875rem/1.9 var(--mono);letter-spacing:0;
  white-space:pre-wrap;word-break:break-all;
}
.brew pre .p{opacity:.45}
.brew a.brew__download{white-space:normal;overflow-wrap:anywhere;text-decoration-line:underline;text-decoration-color:color-mix(in srgb,currentColor 48%,transparent);text-decoration-thickness:.0625em;text-underline-offset:.2em;text-decoration-skip-ink:auto}
.brew__download:hover{text-decoration-color:currentColor}
.shot__cap{margin-top:1rem;text-align:center}
.next__plate.next__plate--icon{max-width:120px;border-radius:24%;border:none}

.bounds{padding-top:clamp(40px,5.5vw,88px)}
.bounds__h2{margin:0;font-size:clamp(26px,3.8vw,54px);max-width:16em}
.bounds__note{margin:1.25rem 0 0;text-align:start}
.bounds__grid{margin:clamp(24px,3vw,44px) 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,48px)}
.bounds__q{color:var(--muted);font-size:.9375rem}
.bounds__a{margin:.5rem 0 0;font-size:.9375rem;line-height:1.75}
@media (max-width:860px){.bounds__grid{grid-template-columns:1fr}}
@media (max-width:560px){.phero__trust li{font-size:.75rem}}
</style>
</head>

<body>


<div class="grain" data-grain-animate="true"></div>


<div data-load-wrap class="loader" id="loader" aria-hidden="true">
  <div data-load-bg class="loader__bg">
    <div data-load-progress class="loader__bg-bar"></div>
  </div>
  <div data-load-container class="loader__container">
    <div class="loader__logo-wrap">
      <div class="loader__logo-item is--base">
        <span class="loader__logo-img" lang="en">XVDL</span>
      </div>
      <div data-load-logo class="loader__logo-item is--top">
        <span class="loader__logo-img" lang="en">XVDL</span>
      </div>
    </div>
    <div class="loader__text-wrap">
      <span data-load-text data-load-reset class="loader__text-el" lang="en">Independent software</span>
      <span data-load-text data-load-reset class="loader__text-el" lang="en">Since 2009</span>
    </div>
  </div>
</div>

<main>

  
  <section class="phero wrap">
    <div class="topbar">
      <nav class="mono topbar__nav" aria-label="Primary">
        <a data-hover href="/" class="topbar__home" aria-label="Home"><span aria-hidden="true" class="topbar__home-dot"></span></a>
      </nav>
      <div class="topbar__app">
        <img src={iconLargeUrl} alt="">
        <h2 class="dsp">XVDL</h2>
      </div>
    </div>

    <div data-reveal-group data-stagger="110" data-distance="1.2em" data-start="top 94%">
      <h1 class="phero__h1 dsp">Save the video. Stay in Safari</h1>
      <div class="shot">
        <img src={inUseUrl} width="1180" height="806" alt="The XVDL download button on an X video post">
      </div>
      <p class="mono shot__cap">The download button appears when a post provides a downloadable MP4.</p>
      <p class="phero__sub">XVDL adds a download button to X video posts and saves the highest-quality available MP4 straight to your Downloads folder. No link copying, no external converter services, no media uploads.</p>
          <div class="phero__cta">
            <a data-hover href="#install" class="button-023">
              <span class="button-023__bg">
                <span style="--index: 0;" class="button-023__bg-inner is--first"></span>
                <span style="--index: 1;" class="button-023__bg-inner is--second"></span>
              </span>
              <span class="button-023__inner">
                <span class="button-023__text is--first">Download XVDL</span>
                <span aria-hidden="true" class="button-023__text is--second">Download XVDL</span>
              </span>
            </a>
            <a data-hover href="https://github.com/cxa/xvdl/releases" class="button-023 button-023--ghost">
              <span class="button-023__bg">
                <span style="--index: 0;" class="button-023__bg-inner is--first"></span>
                <span style="--index: 1;" class="button-023__bg-inner is--second"></span>
              </span>
              <span class="button-023__inner">
                <span class="button-023__text is--first">GitHub Releases</span>
                <span aria-hidden="true" class="button-023__text is--second">GitHub Releases</span>
              </span>
            </a>
          </div>
          <ul class="phero__trust" role="list">
            <li>
              
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 11.5L12 17.5L18 11.5" stroke="currentColor" stroke-miterlimit="10"/><path d="M12 17.5V2.5" stroke="currentColor" stroke-miterlimit="10"/><path d="M3 21H21" stroke="currentColor" stroke-miterlimit="10"/></svg>
              Straight to your Downloads folder
            </li>
            <li>
              
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22 3.5H2V17H22V3.5Z" stroke="currentColor" stroke-miterlimit="10"/><path d="M6.5 20H17.5" stroke="currentColor" stroke-miterlimit="10"/><path d="M12 17V20" stroke="currentColor" stroke-miterlimit="10"/></svg>
              macOS · Safari extension
            </li>
            <li>
              
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20.5 10.5H3.5V21.5H20.5V10.5Z" stroke="currentColor"/><path d="M12 14.5V17" stroke="currentColor"/><path d="M18 10.5V8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8V10.5" stroke="currentColor"/></svg>
              No data collected
            </li>
          </ul>
    </div>
  </section>

  
  <section class="deck wrap">
    <div data-reveal-group data-stagger="140" data-distance="2.1em" data-start="top 88%">

      <article class="card card--c3">
        <p class="card__tag">GitHub Releases</p>
        <div class="card__grid">
          <h3 class="card__title dsp">Install manually</h3>
          <div class="card__body">
          <ul class="card__steps" role="list">
            <li>
              
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 11.5L10 17.5L21 6.5" stroke="currentColor" stroke-miterlimit="10"/></svg>
              <span>Download the latest macOS ZIP from <a data-hover href="https://github.com/cxa/xvdl/releases"><span data-underline-link class="underline-link">GitHub Releases</span></a>.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 11.5L10 17.5L21 6.5" stroke="currentColor" stroke-miterlimit="10"/></svg>
              <span>Unzip the archive and move XVDL.app into your Applications folder.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 11.5L10 17.5L21 6.5" stroke="currentColor" stroke-miterlimit="10"/></svg>
              <span>Open XVDL once before enabling the Safari extension.</span>
            </li>
          </ul>
          </div>
        </div>
      </article>

      <article class="card card--c4">
        <p class="card__tag">One-time setup</p>
        <div class="card__grid">
          <h3 class="card__title dsp">Enable it in Safari</h3>
          <div class="card__body">
          <ul class="card__steps" role="list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 11.5L10 17.5L21 6.5" stroke="currentColor" stroke-miterlimit="10"/></svg>
              <span><b>Open XVDL.</b> Launch the app once after installation. Its setup window links directly to Safari Extension Settings.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 11.5L10 17.5L21 6.5" stroke="currentColor" stroke-miterlimit="10"/></svg>
              <span><b>Safari → Settings → Extensions.</b> Check XVDL to enable it for your active Safari profile.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 11.5L10 17.5L21 6.5" stroke="currentColor" stroke-miterlimit="10"/></svg>
              <span><b>Grant website access.</b> Set permissions for <code>x.com</code> and <code>twitter.com</code> to Allow.</span>
            </li>
          </ul>
          <p class="card__p">Return to an X video post. The XVDL button appears when the post provides a downloadable MP4.</p>
          </div>
        </div>
      </article>

      <article class="card card--ink card--c6">
        <p class="card__tag">Add to Dock</p>
        <div class="card__grid">
          <h3 class="card__title dsp">Works with Safari web apps</h3>
          <div class="card__body">
          <p class="card__p">XVDL also works in Safari web apps saved with Add to Dock. Open the web app, choose its name in the menu bar, then enable XVDL under Settings → Extensions and allow the same website access.</p>
          </div>
        </div>
      </article>

    </div>
  </section>

  
  <section class="bounds wrap" data-reveal-group data-stagger="120" data-distance="1.6em" data-start="top 84%">
    <h2 class="bounds__h2 dsp">The file goes to your Mac, not through us</h2>
    <p class="phero__sub bounds__note">XVDL does not collect, store, sell, or transmit personal data. It does not upload downloaded media or video metadata to lazyapps servers.</p>
    <dl class="bounds__grid">
      <div>
        <dt class="bounds__q">Detects media</dt>
        <dd class="bounds__a">Reads supported X pages and media hosts only to discover available MP4 variants.</dd>
      </div>
      <div>
        <dt class="bounds__q">Sends nothing to us</dt>
        <dd class="bounds__a">No analytics, download history, or media uploads.</dd>
      </div>
      <div>
        <dt class="bounds__q">You decide</dt>
        <dd class="bounds__a">Only save videos you own, have permission to download, or are otherwise authorized to keep.</dd>
      </div>
    </dl>
  </section>

</main>

<footer class="wrap">

  
  <section class="next" data-reveal-group data-stagger="110" data-distance="1.4em" data-start="top 88%">
    <img class="next__plate next__plate--icon" src={iconLargeUrl} alt="">
    <h2 class="next__q dsp">Stay in Safari</h2>
    <div class="next__act">
      <a data-hover href="#install" class="button-023 button-023--square">
        <span class="button-023__bg">
          <span style="--index: 0;" class="button-023__bg-inner is--first"></span>
          <span style="--index: 1;" class="button-023__bg-inner is--second"></span>
        </span>
        <span class="button-023__inner">
          <span class="button-023__text is--first">Download XVDL</span>
          <span aria-hidden="true" class="button-023__text is--second">Download XVDL</span>
        </span>
      </a>
    </div>
  </section>

  <div class="brew" id="install">
    <h3 class="dsp">Install with Homebrew</h3>
    <pre dir="ltr"><span class="p">$</span> brew tap cxa/xvdl https://github.com/cxa/xvdl
<span class="p">$</span> brew install --cask xvdl
<span class="p">$</span> open -a XVDL</pre>
    <p class="bounds__a">On first launch, XVDL links you to Safari’s extension settings. Enable XVDL and allow access to x.com and twitter.com. <a class="brew__download" href="https://github.com/cxa/xvdl/releases">Prefer a direct download? Grab the latest macOS ZIP from GitHub Releases</a>.</p>
  </div>

  <SiteFooterBase />

</footer>

<script is:inline src={gsapUrl}>

</script>
<script is:inline src={scrollTriggerUrl}>

</script>
<script is:inline src={customEaseUrl}>

</script>
<script is:inline src={splitTextUrl}>

</script>

<script is:inline src={logoRevealUrl}>

</script>
<script is:inline src={siteJsUrl}>

</script>

</body>
</html>
