---
import { readFileSync } from 'node:fs';
import PressLayout from '../../layouts/PressLayout.astro';
import { pressKits } from '../../content/presskit-catalog.mjs';
import PressAsset from '../../components/PressAsset.astro';
import NativeAppIcon from '../../components/NativeAppIcon.astro';
import ComputerUseText from '../../components/ComputerUseText.astro';
export function getStaticPaths() {
  return pressKits.map(kit => ({ params: { product: kit.slug }, props: { kit } }));
}
const { kit } = Astro.props;
const base = `/presskit/${kit.slug}/`;
const manifest = JSON.parse(readFileSync(`public${base}manifest.json`, 'utf8'));
const english = kit.locales.find(locale => locale.tag === 'en');
const artwork = english.assets.find(asset => asset.kind === 'artwork');
const metadataFor = asset => manifest.files.find(item => item.path === asset.path);
const bodyFor = locale => locale.description.startsWith(locale.summary + '\n\n') ? locale.description.slice(locale.summary.length).trim() : locale.description;
---
<PressLayout product={kit.name} slug={kit.slug} title={`${kit.name} — Press Kit | lazyapps`} description={`Official press kit for ${kit.name}: product descriptions, images, links and media contact. ${kit.summary.en}`} image={base + artwork.path}>
  <article class="product-kit">
    <section class="kit-hero" aria-labelledby="kit-title">
      <div class="kit-hero__identity">
        <div class="kit-hero__icon" aria-hidden="true"><NativeAppIcon slug={kit.slug} size={300} loading="eager" /></div>
        <h1 id="kit-title"><span class="kit-name" data-press-product="name" lang="en">{english.name}</span><span class="kit-title"><span data-press-text="kit">Press kit</span>&#8288;<span class="kit-dot">.</span></span></h1>
      </div>
      <p class="lead" data-press-product="summary" lang="en" dir="ltr"><ComputerUseText text={english.summary} /></p>
      <div class="actions">
        <a class="button primary" href={`${base}${kit.slug}-presskit.zip`} download><span data-press-text="downloadZip">Download ZIP</span><span aria-hidden="true">↓</span></a>
        <a class="button" href={english.website} data-press-website><span data-press-text="website">Product website</span><span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <dl class="kit-facts">
      <div><dt data-press-text="platformLabel">Platform</dt><dd data-press-product="platform" dir="ltr">{english.platform}</dd></div>
      <div><dt data-press-text="availabilityLabel">Availability</dt><dd data-press-product="availability">{english.availability}</dd></div>
      <div><dt data-press-text="officialLinks">Official links</dt><dd><ul>{english.links.map((link, index) => <li><a href={link.url} data-press-official={index}><span>{link.label}</span><span aria-hidden="true">↗</span></a></li>)}</ul></dd></div>
    </dl>
    <section class="kit-materials" aria-labelledby="materials-title" data-kit-materials>
      <div class="kit-toolbar">
        <h2 id="materials-title" data-press-text="copyImages">Copy & images</h2>
        <p class="kit-material-language" data-press-material-language hidden><span data-press-text="materialLanguage">Material language</span>: <span data-press-material-name lang="en">English</span></p>
      </div>
      {kit.locales.map(locale => <details class="kit-panel" id={`materials-${locale.tag}`} data-kit-panel={locale.tag} open={locale.tag === 'en'}>
        <summary lang={locale.tag}>{locale.displayName}</summary>
        <div class="kit-panel__content" lang={locale.tag} dir={locale.tag === 'ar' ? 'rtl' : 'ltr'}>
          <div class="kit-copy">
            <div><h3>{locale.name}</h3><p class="copy-summary"><ComputerUseText text={locale.summary} locale={locale.tag} /></p><p class="copy-body"><ComputerUseText text={bodyFor(locale)} locale={locale.tag} /></p></div>
            <a class="button readme-download" href={`${base}${locale.tag}/README.md`} download dir="ltr">README.md <span aria-hidden="true">↓</span></a>
          </div>
          <div class="asset-grid">{locale.assets.filter(asset => !asset.alternateFor).map(asset => <PressAsset base={base} asset={asset} metadata={metadataFor(asset)} lang={locale.tag} formats={locale.assets.filter(format => format.alternateFor === asset.filename).map(format => ({ asset: format, metadata: metadataFor(format) }))} />)}</div>
        </div>
      </details>)}
    </section>
  </article>
</PressLayout>
<style>
  .kit-hero{display:flex;flex-direction:column;align-items:center;padding-block:clamp(40px,5vw,72px) clamp(36px,4vw,56px);text-align:center}
  .kit-hero__identity{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;max-width:100%;min-width:0}
  .kit-hero h1{min-width:0;font-size:clamp(56px,6.2vw,88px);text-wrap:balance}
  .kit-hero .kit-title{font:600 clamp(22px,2vw,30px)/var(--leading-display) var(--sans);margin-top:12px;color:var(--muted);letter-spacing:0;text-transform:none;overflow-wrap:normal;word-break:normal}
  .kit-dot{color:var(--accent)}
  .kit-hero .lead{margin-top:28px;font-size:clamp(18px,1.5vw,21px);max-width:min(60ch,100%);text-wrap:balance}
  .kit-hero .actions{justify-content:center;margin-top:24px}
  .kit-name{display:block;font-family:var(--display);text-transform:uppercase;line-height:var(--leading-display)}
  .kit-name:lang(zh),.kit-name:lang(ja),.kit-name:lang(ko){font-family:var(--sans);font-size:.8em;text-transform:none}
  .kit-name[data-bilingual]{white-space:nowrap;overflow-wrap:normal}
  .kit-hero__icon{display:grid;place-items:center;width:clamp(112px,10vw,144px);aspect-ratio:1;flex:none}
  .kit-hero__icon :global(img){width:100%;height:auto;object-fit:contain}
  .kit-facts{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:36px;border-block:1px solid var(--line);padding-block:28px;margin-bottom:52px}
  .kit-facts dt{font-size:14px;color:var(--muted);margin-bottom:12px}
  .kit-facts dd{font-size:16px;line-height:1.65;text-wrap:pretty}
  .kit-facts dd>span{display:block;margin-top:4px;color:var(--muted);font-size:14px}
  .kit-facts ul{list-style:none;padding:0;margin:0}
  .kit-facts a{display:inline-flex;align-items:center;gap:8px;min-height:40px;text-decoration:underline;text-underline-offset:.25em}
  .kit-toolbar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:24px;margin-bottom:28px}
  .kit-toolbar h2{font-size:clamp(28px,3vw,36px);text-wrap:balance}
  .kit-material-language{font-size:14px;color:var(--muted);text-wrap:pretty}
  .kit-panel{margin-top:16px}
  .kit-panel>summary{padding-block:16px;min-height:48px;cursor:pointer;font-size:20px}
  [data-enhanced] .kit-panel>summary{display:none}
  .kit-copy{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:32px;padding:28px 32px;margin-bottom:32px;background:white;border-radius:var(--r-card);box-shadow:0 1px 3px rgba(0,0,0,.04),0 0 0 1px rgba(0,0,0,.06)}
  .kit-copy h3{font:600 16px/1.5 var(--sans);margin-bottom:12px;white-space:nowrap;overflow-wrap:normal}
  .kit-copy .copy-summary{font-size:20px;line-height:1.5;margin-bottom:12px;max-width:54ch;text-wrap:pretty}
  .kit-copy .copy-body{font-size:16px;line-height:1.8;max-width:66ch;text-wrap:pretty}
  .kit-copy .copy-body+.copy-body{margin-top:16px;color:var(--muted)}
  .kit-copy .readme-download{white-space:nowrap;flex-wrap:nowrap;margin-top:0}
  .kit-materials :global(.asset-grid){gap:32px}
  .kit-materials :global(.asset-preview){height:340px;padding:24px;background:rgba(0,0,0,.025);box-shadow:inset 0 0 0 1px rgba(0,0,0,.1)}
  .kit-materials :global(.asset-preview img){object-fit:contain}
  .kit-materials :global(.asset[data-kind="menubar"] .asset-preview){height:160px}
  .kit-materials :global(.asset[data-kind="menubar"] .asset-preview img){width:44px;height:40px;flex:none}
  .kit-materials :global(.asset-caption){padding:16px 2px 0}
  .kit-materials :global(.asset-caption h3){font-size:18px;line-height:1.4;text-wrap:pretty;margin:0}
  .kit-materials :global(.asset-caption .dimensions){font:13px/1.7 var(--sans);font-variant-numeric:tabular-nums;overflow-wrap:anywhere;margin:6px 0 0}
  .kit-materials :global(.asset-caption .note){font-size:14px;line-height:1.6;margin-top:8px;text-wrap:pretty}
  .product-kit :global(a:focus-visible),.kit-panel>summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  @media(max-width:900px){.kit-facts{gap:24px}.kit-copy{padding:24px;gap:24px}}
  @media(max-width:650px){
    .kit-hero{padding-block:32px 36px}
    .kit-hero__identity{gap:20px;width:100%}
    .kit-hero h1{width:100%;font-size:clamp(40px,12vw,56px)}
    .kit-hero .kit-title{font-size:22px;margin-top:10px}
    .kit-name[data-bilingual]{font-size:clamp(20px,6.3vw,32px)}
    .kit-hero__icon{width:80px}
    .kit-hero .lead{font-size:18px;margin-top:24px}
    .kit-hero .actions{gap:10px;margin-top:24px}
    .kit-facts{grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:20px;margin-bottom:36px;padding-block:24px}
    .kit-facts>div:last-child{grid-column:1/-1}
    .kit-facts ul{display:flex;flex-wrap:wrap;gap:8px 20px}
    .kit-facts dt{margin-bottom:6px}
    .kit-toolbar{gap:20px;margin-bottom:24px}
    .kit-toolbar h2{font-size:28px}
    .kit-copy{grid-template-columns:minmax(0,1fr);gap:20px;padding:24px;margin-bottom:24px}
    .kit-copy .readme-download{justify-self:start}
    .kit-materials :global(.asset-grid){gap:28px}
    .kit-materials :global(.asset-preview){height:300px}
  }
</style>
