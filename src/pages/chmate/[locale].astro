---
import CHMatePage from '../../components/CHMatePage.astro';
import { CHMATE_LOCALES } from '../../i18n/chmate-locales.mjs';

export function getStaticPaths() {
  return Object.keys(CHMATE_LOCALES)
    .filter((code) => code !== '')
    .map((code) => ({ params: { locale: code } }));
}

const t = CHMATE_LOCALES[Astro.params.locale] ?? CHMATE_LOCALES.en;
---

<CHMatePage t={t} isRoot={false} />
