---
import { YIYAN_LOCALES } from '../../i18n/yiyan-locales.mjs';
import YiYanPage from '../../components/YiYanPage.astro';

export function getStaticPaths() {
  return Object.keys(YIYAN_LOCALES)
    .filter((code) => code !== '')
    .map((code) => ({ params: { locale: code } }));
}

const t = YIYAN_LOCALES[Astro.params.locale];
---
<YiYanPage t={t} isRoot={false} />