---
const SITE = 'https://lazyapps.com';
const title = 'lazyapps — Apps for Mac, iPhone & iPad';
const description = 'Mac, iPhone and iPad apps for English practice, X video downloads, EPUB and CHM reading, country facts and fonts. Shheep, a sheep-counting game for iPhone and iPad, is coming soon.';
import NativeAppIcon from '../components/NativeAppIcon.astro';
import SocialMeta from '../components/SocialMeta.astro';
import StructuredData from '../components/StructuredData.astro';
import SiteGrain from '../components/SiteGrain.astro';
import SiteFooterBase from '../components/SiteFooterBase.astro';
import SitePreloader from '../components/SitePreloader.astro';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
import opengraphUrl from '$assets/img/opengraph.png?url';
import showcaseUrl from '$assets/img/yiyan-learning-log.png?url';
import inUseUrl from '$assets/img/xvdl-in-use.png?url';
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#171717" data-page-color="#e8e8e6">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" data-page-color="#e8e8e6">
<SocialMeta
  title={title}
  description={description}
  url={`${SITE}/`}
  image={`${SITE}${opengraphUrl}`}
  imageAlt="lazyapps logo"
  imageWidth={1200}
  imageHeight={630}
  locale="en_US"
/>
<StructuredData data={{
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'lazyapps', description, inLanguage: 'en', publisher: { '@id': `${SITE}/#organization` } },
    { '@type': 'Organization', '@id': `${SITE}/#organization`, url: `${SITE}/`, name: 'lazyapps', foundingDate: '2009' },
  ],
}} />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2215%22%20fill%3D%22%23171717%22%2F%3E%3Cpath%20fill%3D%22%23f8f8f6%22%20d%3D%22M20%2013h12v33h17v10H20z%22%2F%3E%3Ccircle%20cx%3D%2245%22%20cy%3D%2219%22%20r%3D%225%22%20fill%3D%22%23ff6846%22%2F%3E%3C%2Fsvg%3E">
<link rel="stylesheet" href={siteCssUrl}>

<script is:inline>
document.documentElement.classList.remove('no-js');
setTimeout(function(){
  document.documentElement.classList.add('is-page-theme');
  document.documentElement.classList.add('is-loaded');
  var l = document.getElementById('loader');
  if (l) l.remove();
  document.querySelectorAll('meta[name="theme-color"][data-page-color]').forEach(function(meta){
    meta.setAttribute('content', meta.getAttribute('data-page-color'));
  });
}, 6000);
</script>
<style is:inline>
.deck{padding-top:clamp(28px,4vw,48px)}
.deck>[data-reveal-group]{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:var(--space-grid);align-items:stretch;
}
.card{
  --card-rotate:0deg;
  position:relative;isolation:isolate;display:flex;min-width:0;overflow:clip;flex-direction:column;
  background:var(--fill);color:var(--fg,var(--ink));
  border:1px solid rgba(23,23,23,.08);border-radius:var(--r-card);
  padding:var(--space-card);
  transform:rotate(var(--card-rotate));transform-origin:center;
  transition:transform .32s cubic-bezier(.2,.8,.2,1);
}
.card--featured{grid-column:1/-1}
.card--yiyan{--fill:var(--app-yiyan)}
.card--xvdl{--fill:var(--app-xvdl)}
.card--chmate{--fill:var(--app-chmate)}
.card--cia{--fill:var(--app-world-book)}
.card--yifan{--fill:oklch(0.8 0.1 160)}
.card--fondfont{--fill:var(--app-fondfont)}
.card--shheep{--fill:var(--app-shheep)}
.card--shheep .card__shots img{image-rendering:pixelated}
.card:nth-child(odd){--card-rotate:-1deg}
.card:nth-child(even){--card-rotate:1deg}
.card__tag{
  display:inline-flex;width:max-content;max-width:100%;margin-left:auto;
  padding:.375rem .625rem;border-radius:999px;
  background:color-mix(in oklch,currentColor 6%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 10%,transparent);
  font:400 .6875rem/1.4 var(--mono);text-transform:uppercase;letter-spacing:.09em;opacity:.7;
}
.card__grid{
  flex:1;display:grid;grid-template-columns:minmax(0,9fr) minmax(240px,8fr);
  gap:var(--space-grid);align-items:stretch;padding-top:var(--space-grid);
}
.card--compact .card__grid{grid-template-columns:minmax(0,1fr)}
.card__copy{display:flex;min-width:0;flex-direction:column;align-items:flex-start}
.card__heading{display:flex;min-width:0;align-items:center;gap:clamp(8px,.8vw,10px);font:900 clamp(34px,4.6vw,64px)/1 var(--display-latin)}
.card__title{font-size:inherit;text-box:trim-both cap alphabetic}
.card--compact .card__heading{font-size:clamp(30px,3.2vw,44px)}
.card--yifan .card__title{text-box:normal}
.card__p{margin-top:1rem;max-width:34em;font-size:1rem;line-height:1.7}
.card__foot{margin-top:auto;padding-top:clamp(20px,2.4vw,30px)}
.card .card__icon{width:1.12cap;height:1.12cap;object-fit:contain;flex:none}
.card__go{
  display:inline-flex;min-height:44px;align-items:center;gap:.75rem;
  padding:.75rem .875rem .75rem 1rem;border-radius:999px;
  background:color-mix(in oklch,currentColor 7%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 12%,transparent);
  font:600 .9375rem/1 var(--sans);
}
.card__go::after{content:"";position:absolute;z-index:2;inset:0}
.card__go>*{position:relative;z-index:3}
.card__go:focus-visible{outline:none}
.card:has(.card__go:focus-visible){outline:2px solid var(--accent);outline-offset:4px}
.card__arrow{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;background:color-mix(in oklch,currentColor 9%,transparent)}
.card__shots{
  display:grid;min-width:0;overflow:hidden;place-items:center;padding:clamp(12px,1.5vw,20px);
  border-radius:calc(var(--r-card) - 6px);
  background:color-mix(in oklch,currentColor 6%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 9%,transparent);
}
.card__shots img{
  width:100%;height:100%;max-height:clamp(190px,22vw,320px);object-fit:cover;object-position:top;
  border-radius:min(1.2vw,8px);outline:1px solid color-mix(in oklch,currentColor 10%,transparent);outline-offset:-1px;
}
.card--yiyan .card__shots{aspect-ratio:auto}
.card--yiyan .card__shots img{height:auto;max-height:none;object-fit:contain;outline:none}
@media (hover:hover) and (pointer:fine){
  .card:has(.card__go:hover){z-index:4;transform:translateY(-6px) rotate(0)}
  .card:has(.card__go:active){transform:translateY(-2px) rotate(0) scale(.995)}
  .card:has(.card__go:hover) .card__go{background:color-mix(in oklch,currentColor 11%,transparent)}
}
@media (max-width:720px){
  .deck>[data-reveal-group]{grid-template-columns:minmax(0,1fr)}
  .card--featured{grid-column:auto}
  .card__grid{grid-template-columns:minmax(0,1fr)}
  .card__shots{aspect-ratio:16/9}
}
@media (max-width:560px){
  .card{border-radius:14px;padding:20px;transform:none}
  .card__tag{font-size:.6875rem}
  .card__heading{font-size:36px}
  .card--compact .card__heading{font-size:32px}
  .card__p{font-size:1.0625rem;line-height:1.65}
  .card__foot{width:100%;padding-top:20px}
  .card__go{width:100%;min-height:48px;justify-content:space-between}
  .card__shots{padding:10px;border-radius:10px}
}
@media (max-width:360px){
  .card__heading{font-size:34px}
  .card--compact .card__heading{font-size:30px}
}
</style>
</head>

<body>


<SiteGrain animated />


<SitePreloader name="LAZYAPPS" />

<main>

  
  <section class="hero wrap">
    <h1 class="hero__brand dsp">
      <span class="wordmark">lazyapps<i aria-hidden="true"></i></span>
    </h1>

    <div data-reveal-group data-stagger="110" data-distance="1.2em" data-start="top 92%">
      <p class="hero__sub">Mac tools, iPhone and iPad apps, and a sheep-counting game for iOS.</p>
    </div>

  </section>

  
  <section class="deck wrap" id="deck">
    <div data-reveal-group data-stagger="140" data-distance="2.1em" data-start="top 88%">

      <article class="card card--featured card--shheep" id="shheep">
        <p class="card__tag">iPhone · iPad · Coming soon</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="shheep" size={72} class="card__icon" />
              <h2 class="card__title dsp">Shheep</h2>
            </div>
            <p class="card__p">A sheep-counting game for iPhone and iPad. Jump over fences, duck under bats and try a new course each night. Coming soon on the App Store; try the web demo now.</p>
            <div class="card__foot">
              <a data-hover href="/shheep/" class="card__go"><span>Discover Shheep</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="card__shots">
            <img src="/shheep/preview.png" width="1050" height="560" alt="Shheep’s pixel bedroom, with a sleepy girl and a sheep-filled thought bubble">
          </div>
        </div>
      </article>


      <article class="card card--featured card--yiyan" id="yiyan">
        <p class="card__tag">macOS 15+ · iPhone beta</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="yiyan" size={72} class="card__icon" />
              <h2 class="card__title dsp">YiYan</h2>
            </div>
            <p class="card__p">Turn input from AI coding tools such as Claude Code and Codex into natural English, with explanations and examples. Polish selected text or the current input field on Mac.</p>
            <div class="card__foot">
              <a data-hover href="/yiyan/en/" class="card__go"><span>YiYan details</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="card__shots">
            <img src={showcaseUrl} alt="YiYan learning log on macOS" width="1616" height="1388">
          </div>
        </div>
      </article>

      <article class="card card--featured card--xvdl">
        <p class="card__tag">macOS · Safari extension</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="xvdl" size={72} class="card__icon" />
              <h2 class="card__title dsp">XVDL</h2>
            </div>
            <p class="card__p">Download videos from X in Safari on your Mac. Save the highest-quality available MP4 directly to your Downloads folder.</p>
            <div class="card__foot">
              <a data-hover href="/xvdl/" class="card__go"><span>XVDL details</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="card__shots">
            <img src={inUseUrl} alt="XVDL download button on an X video post">
          </div>
        </div>
      </article>

      <article class="card card--compact card--chmate">
        <p class="card__tag">iPhone &amp; iPad · EPUB / CHM reader</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="chmate" size={72} class="card__icon" />
              <h2 class="card__title dsp">CHMate</h2>
            </div>
            <p class="card__p">Read EPUB ebooks, CHM documents and MHT files on iPhone and iPad. Search across chapters, highlight passages and add notes.</p>
            <div class="card__foot">
              <a data-hover href="/chmate/en/" class="card__go"><span>CHMate details</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--cia">
        <p class="card__tag">iPhone &amp; iPad · Offline atlas</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="world-book" size={72} class="card__icon" />
              <h2 class="card__title dsp">World Book</h2>
            </div>
            <p class="card__p">Look up country profiles, flags and rankings, and explore a 3D globe offline. Download photos and regional maps to view them offline too.</p>
            <div class="card__foot">
              <a data-hover href="/world-book/" class="card__go"><span>World Book details</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--yifan">
        <p class="card__tag">iPhone &amp; iPad · Fanfou client</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="yifan" size={72} class="card__icon" />
              <h2 class="card__title dsp"><span class="zh" lang="zh">一饭</span></h2>
            </div>
            <p class="card__p">Read your Fanfou timeline, mentions and direct messages on iPhone and iPad. View favorites and photos.</p>
            <div class="card__foot">
              <a data-hover href="https://apps.apple.com/us/app/%E4%B8%80%E9%A5%AD-%E5%B2%81%E9%9D%99%E9%A5%AD%E5%90%A6%E5%AE%A2%E6%88%B7%E7%AB%AF/id541110403?uo=4" class="card__go"><span>View on App Store</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--fondfont">
        <p class="card__tag">iPhone &amp; iPad · Font installer</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="fondfont" size={72} class="card__icon" />
              <h2 class="card__title dsp">FondFont</h2>
            </div>
            <p class="card__p">Install your TTF, OTF and TTC font files on iPhone and iPad. Use them in apps that support the iOS font library, including Pages and Keynote.</p>
            <div class="card__foot">
              <a data-hover href="/fondfont/en/" class="card__go"><span>FondFont details</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

    </div>
  </section>

</main>

<footer class="wrap">

  
  <SiteFooterBase />

</footer>

<script is:inline src={gsapUrl}>

</script>
<script is:inline src={scrollTriggerUrl}>

</script>
<script is:inline src={customEaseUrl}>

</script>
<script is:inline src={splitTextUrl}>

</script>

<script is:inline src={logoRevealUrl}>

</script>
<script is:inline src={siteJsUrl}>

</script>

</body>
</html>
