---
const SITE = 'https://lazyapps.com';
const title = 'lazyapps — Apps for Mac, iPhone & iPad';
const description = 'Mac, iPhone and iPad apps for screen dimming during AI computer use, English practice, X video downloads, EPUB and CHM reading, country facts and fonts. Shheep is a sheep-counting game for iPhone and iPad.';
import { DOZE_LOCALES } from '../i18n/doze-locales.mjs';
import ComputerUseText from '../components/ComputerUseText.astro';
const doze = DOZE_LOCALES.en;
import NativeAppIcon from '../components/NativeAppIcon.astro';
import CardAction from '../components/CardAction.astro';
import SocialMeta from '../components/SocialMeta.astro';
import StructuredData from '../components/StructuredData.astro';
import SiteGrain from '../components/SiteGrain.astro';
import SiteEdges from '../components/SiteEdges.astro';
import SiteFooterBase from '../components/SiteFooterBase.astro';
import SitePreloader from '../components/SitePreloader.astro';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
import opengraphUrl from '$assets/img/opengraph.png?url';
import showcaseUrl from '$assets/img/yiyan-learning-log.png?url';
import inUseUrl from '$assets/img/xvdl-in-use.png?url';
import { Image, getImage } from 'astro:assets';
import dozePanel from '../../scripts/assets/presskit/doze-panel-en-light.png';
import dozeDayLandscape from '$assets/img/doze-landscape-day-cozy-doodle.png';
import yiyanDesktopArtwork from '$assets/img/yiyan-desert-desktop.png';
import shheepNightArtwork from '$assets/img/shheep-pixel-night-background.png';
import xvdlBlueHourArtwork from '$assets/img/xvdl-blue-hour-background.png';
const [dozeLandscape, yiyanDesktop, shheepNight, xvdlBlueHour] = await Promise.all([
  getImage({ src: dozeDayLandscape, width: 1200, format: 'webp', quality: 90 }),
  getImage({ src: yiyanDesktopArtwork, width: 1200, format: 'webp', quality: 85 }),
  getImage({ src: shheepNightArtwork, width: 1200, format: 'webp', quality: 90 }),
  getImage({ src: xvdlBlueHourArtwork, width: 1200, format: 'webp', quality: 85 }),
]);
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#f8f8f6">
<SocialMeta
  title={title}
  description={description}
  url={`${SITE}/`}
  image={`${SITE}${opengraphUrl}`}
  imageAlt="lazyapps logo"
  imageWidth={1200}
  imageHeight={630}
  locale="en_US"
/>
<StructuredData data={{
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'lazyapps', description, inLanguage: 'en', publisher: { '@id': `${SITE}/#organization` } },
    { '@type': 'Organization', '@id': `${SITE}/#organization`, url: `${SITE}/`, name: 'lazyapps', foundingDate: '2009' },
  ],
}} />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2215%22%20fill%3D%22%23171717%22%2F%3E%3Cpath%20fill%3D%22%23f8f8f6%22%20d%3D%22M20%2013h12v33h17v10H20z%22%2F%3E%3Ccircle%20cx%3D%2245%22%20cy%3D%2219%22%20r%3D%225%22%20fill%3D%22%23ff6846%22%2F%3E%3C%2Fsvg%3E">
<link rel="stylesheet" href={siteCssUrl}>

<script is:inline>
document.documentElement.classList.remove('no-js');
setTimeout(function(){
  document.documentElement.classList.add('is-page-theme');
  document.documentElement.classList.add('is-loaded');
  var l = document.getElementById('loader');
  if (l) l.remove();
}, 6000);
</script>
<style is:inline>
.deck{
  --space-card:clamp(28px,3.4vw,52px);--space-grid:clamp(24px,3vw,44px);
  --r-card:32px;
  padding-top:clamp(28px,4vw,48px);
}
.deck>[data-reveal-group]{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:var(--space-grid);align-items:stretch;
}
.card{
  --card-rotate:0deg;
  --tag-font-size:.65rem;--tag-gap:.5rem;--tag-padding-block:.25rem;
  position:relative;isolation:isolate;display:flex;min-width:0;overflow:clip;flex-direction:column;
  background:var(--fill);color:var(--fg,var(--ink));
  border-radius:var(--r-card);
  box-shadow:0 0 0 1px #0000000e,0 2px 4px -2px #0000000f,0 10px 24px -16px #00000024;
  padding:var(--space-card);
  transform:rotate(var(--card-rotate));transform-origin:center;
  transition:transform .32s cubic-bezier(.2,.8,.2,1);
}
.card--featured{grid-column:1/-1}
.card--doze{--fill:var(--app-doze)}
.card--yiyan{--fill:var(--app-yiyan)}
.card--xvdl{--fill:var(--app-xvdl);--icon-optical-scale:1.34214}
.card--chmate{--fill:var(--app-chmate)}
.card--cia{--fill:var(--app-world-book)}
.card--yifan{--fill:oklch(0.8 0.1 160)}
.card--fondfont{--fill:var(--app-fondfont)}
.card--shheep{--fill:var(--app-shheep)}
.card--shheep .card__shots img{image-rendering:pixelated}
.card:nth-child(odd){--card-rotate:-1deg}
.card:nth-child(even){--card-rotate:1deg}
.card__tag{
  display:inline-flex;width:max-content;max-width:100%;margin:var(--tag-gap) 0 0;
  padding:var(--tag-padding-block) .5rem;border-radius:999px;
  background:color-mix(in oklch,currentColor 6%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 10%,transparent);
  font:500 var(--tag-font-size)/1.3 var(--sans);text-transform:none;letter-spacing:0;opacity:.7;
}
.card__grid{
  flex:1;display:grid;grid-template-columns:minmax(0,9fr) minmax(240px,8fr);
  gap:var(--space-grid);align-items:stretch;
}
.card--compact .card__grid{grid-template-columns:minmax(0,1fr)}
.card__copy{display:flex;min-width:0;flex-direction:column;align-items:flex-start}
.card__heading{
  --icon-size:calc(var(--icon-title-height,1cap) + var(--tag-gap) + var(--tag-font-size)*1.3 + var(--tag-padding-block)*2);
  display:flex;min-width:0;align-items:center;gap:clamp(12px,1.2vw,18px);font:900 clamp(34px,4.6vw,64px)/1 var(--display-latin);
}
.card__identity{display:flex;min-width:0;flex-direction:column;align-items:flex-start}
.card__meta{display:flex;align-items:center;gap:12px;margin-top:var(--tag-gap);white-space:nowrap}
.card__meta .card__tag{margin:0;flex:none}
.card__press{
  --card-action-min-height:0px;--card-action-font-size:var(--tag-font-size);
  --card-action-padding-block:0px;
}
.card__press::before{content:"";position:absolute;inset-inline:0;top:50%;height:44px;transform:translateY(-50%)}
.card__title{font-size:inherit;text-box:trim-both cap alphabetic}
.card--compact .card__heading{font-size:clamp(30px,3.2vw,44px)}
.card--yifan .card__title{text-box:normal}
.card--yifan .card__heading{--icon-title-height:1em}
.card__p{margin-top:clamp(24px,2.6vw,32px);max-width:34em;font-size:1rem;line-height:1.7}
.card__foot{margin-top:auto;padding-top:clamp(28px,3vw,40px)}
.card .card__icon{width:var(--icon-size);height:var(--icon-size);object-fit:contain;flex:none;scale:var(--icon-optical-scale,1.08)}
.card:has(.card__go:focus-visible){outline:2px solid var(--accent);outline-offset:4px}
.card__shots{
  --shot-padding:clamp(12px,1.5vw,20px);
  display:grid;min-width:0;overflow:hidden;place-items:center;padding:var(--shot-padding);
  border-radius:0;
  background:color-mix(in oklch,currentColor 6%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 9%,transparent);
}
.card--featured .card__shots{
  justify-self:stretch;
  margin:calc(-1 * var(--space-card)) calc(-1 * var(--space-card)) calc(-1 * var(--space-card)) 0;
}
.card__shots img{
  width:100%;height:100%;max-height:clamp(190px,22vw,320px);object-fit:cover;object-position:top;
  border-radius:8px;outline:1px solid rgba(0,0,0,.1);outline-offset:-1px;
}
.card--shheep .card__shots,.card--xvdl .card__shots{
  --shot-padding:clamp(20px,2.5vw,32px);
  background-position:center;background-size:cover;
}
.card--shheep .card__shots{background-color:#49476f}
.card--xvdl .card__shots{background-color:#425d7d}
.card--shheep .card__shots img,.card--xvdl .card__shots img{
  width:auto;height:auto;max-width:100%;object-fit:contain;
  box-shadow:0 12px 28px -8px #0000004d;
}
.card--yiyan .card__shots{
  aspect-ratio:auto;background-color:#d6baa0;background-position:center;background-size:cover;
}
.card--yiyan .card__shots img{
  height:auto;max-height:none;object-fit:contain;outline:none;
  filter:drop-shadow(0 14px 20px #31271940) drop-shadow(0 2px 4px #31271926);
}
.card--doze .card__shots{
  --shot-padding:clamp(28px,3vw,40px);
  aspect-ratio:auto;background-color:#faf9ef;
  background-repeat:no-repeat;background-position:center calc(100% + 20px);
  background-size:calc(100% + 32px) auto;
}
.card--doze .card__shots img{
  width:clamp(208px,22vw,272px);height:auto;max-width:100%;max-height:none;object-fit:contain;
  border-radius:12px;
  box-shadow:0 2px 6px -2px rgba(0,0,0,.12),0 14px 28px -8px rgba(0,0,0,.16);
}
@media (hover:hover) and (pointer:fine){
  .card:has(.card__go:hover){z-index:4;transform:translateY(-6px) rotate(0)}
  .card:has(.card__go:active){transform:translateY(-2px) rotate(0) scale(.995)}
}
@media (max-width:720px){
  .deck>[data-reveal-group]{grid-template-columns:minmax(0,1fr)}
  .card--featured{grid-column:auto}
  .card__grid{grid-template-columns:minmax(0,1fr)}
  .card__shots{aspect-ratio:16/9}
  .card--featured .card__shots{margin:0 calc(-1 * var(--space-card)) calc(-1 * var(--space-card))}
}
@media (max-width:560px){
  .deck{--space-card:28px;--r-card:24px}
  .card{transform:none}
  .card__heading{font-size:36px}
  .card--compact .card__heading{font-size:32px}
  .card__p{font-size:1.0625rem;line-height:1.65}
  .card__foot{--card-action-min-height:48px;width:100%;padding-top:28px}
  .card__go{width:100%}
  .card__shots{--shot-padding:12px}
}
@media (max-width:360px){
  .deck{--space-card:24px}
  .card__heading{font-size:34px}
  .card--compact .card__heading{font-size:30px}
}
</style>
</head>

<body>


<SiteEdges />
<SiteGrain animated />


<SitePreloader name="LAZYAPPS" />

<main>

  
  <section class="hero wrap">
    <div data-reveal-group data-stagger="110" data-distance="1.2em" data-start="top 92%">
      <p class="hero__sub"><span class="hero__sub-phrase">Tools, apps and games</span>{' '}<span class="hero__sub-phrase">for macOS, iOS and iPadOS</span></p>
    </div>

    <h1 class="hero__brand dsp">
      <span class="wordmark">lazyapps<i aria-hidden="true"></i></span>
    </h1>

  </section>

  
  <section class="deck wrap" id="deck">
    <div data-reveal-group data-stagger="140" data-distance="2.1em" data-start="top 88%">

      <article class="card card--featured card--doze" id="doze">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="doze" size={80} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">Doze</h2>
                <div class="card__meta">
                  <p class="card__tag">macOS</p>
                  <CardAction href="/doze/presskit/#en" aria-label="Doze Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p"><ComputerUseText text={doze.description} /></p>
            <div class="card__foot">
              <CardAction href={doze.selectedUrl} class="card__go" stretched>Doze details</CardAction>
            </div>
          </div>
          <div class="card__shots" style={{ backgroundImage: `url("${dozeLandscape.src}")` }}>
            <Image src={dozePanel} width={384} densities={[1, 2]} format="webp" quality={90} alt="Doze’s Mac settings for screen dimming and keeping computer use running" />
          </div>
        </div>
      </article>


      <article class="card card--featured card--shheep" id="shheep">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="shheep" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">Shheep</h2>
                <div class="card__meta">
                  <p class="card__tag">iPhone · iPad</p>
                  <CardAction href="/shheep/presskit/#en" aria-label="Shheep Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p">A sheep-counting game for iPhone and iPad. Jump over fences, duck under bats and try a new course each night. Download on the App Store or try the web demo.</p>
            <div class="card__foot">
              <CardAction href="/shheep/" class="card__go" stretched>Discover Shheep</CardAction>
            </div>
          </div>
          <div class="card__shots" style={{ backgroundImage: `url("${shheepNight.src}")` }}>
            <img src="/shheep/preview.png" width="1050" height="560" alt="Shheep’s pixel bedroom, with a sleepy girl and a sheep-filled thought bubble">
          </div>
        </div>
      </article>

      <article class="card card--featured card--yiyan" id="yiyan">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="yiyan" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">YiYan</h2>
                <div class="card__meta">
                  <p class="card__tag">macOS · iPhone</p>
                  <CardAction href="/yiyan/presskit/#en" aria-label="YiYan Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p">Turn input from AI coding tools such as Claude Code and Codex into natural English, with explanations and examples. Polish selected text or the current input field on Mac.</p>
            <div class="card__foot">
              <CardAction href="/yiyan/en/" class="card__go" stretched>YiYan details</CardAction>
            </div>
          </div>
          <div class="card__shots" style={{ backgroundImage: `url("${yiyanDesktop.src}")` }}>
            <img src={showcaseUrl} alt="YiYan learning log on macOS" width="1616" height="1388">
          </div>
        </div>
      </article>

      <article class="card card--featured card--xvdl">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="xvdl" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">XVDL</h2>
                <div class="card__meta">
                  <p class="card__tag">macOS</p>
                  <CardAction href="/xvdl/presskit/#en" aria-label="XVDL Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p">Download videos from X in Safari on your Mac. Save the highest-quality available MP4 directly to your Downloads folder.</p>
            <div class="card__foot">
              <CardAction href="/xvdl/" class="card__go" stretched>XVDL details</CardAction>
            </div>
          </div>
          <div class="card__shots" style={{ backgroundImage: `url("${xvdlBlueHour.src}")` }}>
            <img src={inUseUrl} alt="XVDL download button on an X video post">
          </div>
        </div>
      </article>

      <article class="card card--compact card--chmate">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="chmate" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">CHMate</h2>
                <div class="card__meta">
                  <p class="card__tag">iPhone · iPad</p>
                  <CardAction href="/chmate/presskit/#en" aria-label="CHMate Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p">Read EPUB ebooks, CHM documents and MHT files on iPhone and iPad. Search across chapters, highlight passages and add notes.</p>
            <div class="card__foot">
              <CardAction href="/chmate/en/" class="card__go" stretched>CHMate details</CardAction>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--cia">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="world-book" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">World Book</h2>
                <div class="card__meta">
                  <p class="card__tag">iPhone · iPad</p>
                  <CardAction href="/world-book/presskit/#en" aria-label="World Book Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p">Look up country profiles, flags and rankings, and explore a 3D globe offline. Download photos and regional maps to view them offline too.</p>
            <div class="card__foot">
              <CardAction href="/world-book/" class="card__go" stretched>World Book details</CardAction>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--yifan">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="yifan" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp"><span class="zh" lang="zh">一饭</span></h2>
                <p class="card__tag">iPhone · iPad</p>
              </div>
            </div>
            <p class="card__p">Read your Fanfou timeline, mentions and direct messages on iPhone and iPad. View favorites and photos.</p>
            <div class="card__foot">
              <CardAction href="https://apps.apple.com/us/app/%E4%B8%80%E9%A5%AD-%E5%B2%81%E9%9D%99%E9%A5%AD%E5%90%A6%E5%AE%A2%E6%88%B7%E7%AB%AF/id541110403?uo=4" class="card__go" stretched>View on App Store</CardAction>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--fondfont">
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <NativeAppIcon slug="fondfont" size={96} class="card__icon" />
              <div class="card__identity">
                <h2 class="card__title dsp">FondFont</h2>
                <div class="card__meta">
                  <p class="card__tag">iPhone · iPad</p>
                  <CardAction href="/fondfont/presskit/#en" aria-label="FondFont Press Kit" class="card__press" secondary arrow={false}>Press Kit</CardAction>
                </div>
              </div>
            </div>
            <p class="card__p">Install your TTF, OTF and TTC font files on iPhone and iPad. Use them in apps that support the iOS font library, including Pages and Keynote.</p>
            <div class="card__foot">
              <CardAction href="/fondfont/en/" class="card__go" stretched>FondFont details</CardAction>
            </div>
          </div>
        </div>
      </article>

    </div>
  </section>

</main>

<footer class="wrap">

  
  <SiteFooterBase />

</footer>

<script is:inline src={gsapUrl}>

</script>
<script is:inline src={scrollTriggerUrl}>

</script>
<script is:inline src={customEaseUrl}>

</script>
<script is:inline src={splitTextUrl}>

</script>

<script is:inline src={logoRevealUrl}>

</script>
<script is:inline src={siteJsUrl}>

</script>

</body>
</html>
