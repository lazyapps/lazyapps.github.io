---
const SITE = 'https://lazyapps.com';
import SocialMeta from '../components/SocialMeta.astro';
import SiteFooterBase from '../components/SiteFooterBase.astro';
import siteCssUrl from '$assets/s/site.css?url';
import gsapUrl from '$assets/vendor/gsap.min.js?url';
import scrollTriggerUrl from '$assets/vendor/ScrollTrigger.min.js?url';
import customEaseUrl from '$assets/vendor/CustomEase.min.js?url';
import splitTextUrl from '$assets/vendor/SplitText.min.js?url';
import logoRevealUrl from '$assets/s/logo-reveal-loader.js?url';
import siteJsUrl from '$assets/s/site.js?url';
import keyhopIconUrl from '$assets/img/keyhop-symbol.png?url';
import keyhopSettingsUrl from '$assets/img/keyhop-settings.png?url';
import yiyanIconUrl from '$assets/img/yiyan-symbol.png?url';
import xvdlIconUrl from '$assets/img/xvdl-symbol.svg?url';
import opengraphUrl from '$assets/img/opengraph.png?url';
import showcaseUrl from '$assets/img/yiyan-learning-log.png?url';
import inUseUrl from '$assets/img/xvdl-in-use.png?url';
import appChmateUrl from '$assets/img/app-chmate.jpg?url';
import appCiaUrl from '$assets/img/app-cia.jpg?url';
import appYifanUrl from '$assets/img/app-yifan.jpg?url';
import appFondfontUrl from '$assets/img/app-fondfont.jpg?url';
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>lazyapps — Independent software since 2009</title>
<meta name="description" content="Small, focused tools for Mac, iPhone, and iPad. Built with care, zero tracking, and maintained by lazyapps since 2009.">
<meta name="theme-color" content="#171717" data-page-color="#e8e8e6">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" data-page-color="#e8e8e6">
<SocialMeta
  title="lazyapps — Independent software since 2009"
  description="Small, focused tools for Mac, iPhone, and iPad. Built with care, zero tracking, and maintained by lazyapps since 2009."
  url={`${SITE}/`}
  image={`${SITE}${opengraphUrl}`}
  imageAlt="lazyapps — Independent software since 2009"
  imageWidth={1200}
  imageHeight={630}
  locale="en_US"
/>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2215%22%20fill%3D%22%23171717%22%2F%3E%3Cpath%20fill%3D%22%23f8f8f6%22%20d%3D%22M20%2013h12v33h17v10H20z%22%2F%3E%3Ccircle%20cx%3D%2245%22%20cy%3D%2219%22%20r%3D%225%22%20fill%3D%22%23ff6846%22%2F%3E%3C%2Fsvg%3E">
<link rel="stylesheet" href={siteCssUrl}>

<script is:inline>
document.documentElement.classList.remove('no-js');
setTimeout(function(){
  document.documentElement.classList.add('is-page-theme');
  document.documentElement.classList.add('is-loaded');
  var l = document.getElementById('loader');
  if (l) l.remove();
  document.querySelectorAll('meta[name="theme-color"][data-page-color]').forEach(function(meta){
    meta.setAttribute('content', meta.getAttribute('data-page-color'));
  });
}, 6000);
</script>
<style is:inline>
.deck{padding-top:clamp(28px,4vw,48px);padding-bottom:clamp(40px,5vw,80px)}
.deck>[data-reveal-group]{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:clamp(16px,2vw,28px);align-items:stretch;
}
.card{
  --card-rotate:0deg;
  position:relative;isolation:isolate;display:flex;min-width:0;overflow:clip;flex-direction:column;
  background:var(--fill);color:var(--fg,var(--ink));
  border:1px solid rgba(23,23,23,.08);border-radius:var(--r-card);
  padding:clamp(20px,2.4vw,34px);
  transform:rotate(var(--card-rotate));transform-origin:center;
  transition:transform .32s cubic-bezier(.2,.8,.2,1);
}
.card--featured{grid-column:1/-1}
.card--yiyan{--fill:oklch(0.9 0.152 95)}
.card--xvdl{--fill:oklch(0.8 0.099 225)}
.card--chmate{--fill:oklch(0.8 0.102 245)}
.card--cia{--fill:oklch(0.8 0.176 145)}
.card--yifan{--fill:oklch(0.8 0.1 160)}
.card--fondfont{--fill:oklch(0.9 0.17 105)}
.card--keyhop{--fill:oklch(0.8 0.083 300)}
.card:nth-child(odd){--card-rotate:-1deg}
.card:nth-child(even){--card-rotate:1deg}
.card__tag{
  display:inline-flex;width:max-content;max-width:100%;margin-left:auto;
  padding:.375rem .625rem;border-radius:999px;
  background:color-mix(in oklch,currentColor 6%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 10%,transparent);
  font:400 .6875rem/1.4 var(--mono);text-transform:uppercase;letter-spacing:.09em;opacity:.7;
}
.card__grid{
  flex:1;display:grid;grid-template-columns:minmax(0,9fr) minmax(240px,8fr);
  gap:clamp(20px,3vw,48px);align-items:stretch;padding-top:clamp(20px,2.4vw,32px);
}
.card--compact .card__grid{grid-template-columns:minmax(0,1fr);padding-top:clamp(24px,3vw,40px)}
.card__copy{display:flex;min-width:0;flex-direction:column;align-items:flex-start}
.card__heading{display:flex;min-width:0;align-items:center;gap:clamp(8px,.8vw,10px);font:900 clamp(34px,4.6vw,64px)/1 var(--display-latin)}
.card__title{font-size:inherit;text-box:trim-both cap alphabetic}
.card--compact .card__heading{font-size:clamp(30px,3.2vw,44px)}
.card--yifan .card__title{text-box:normal}
.card__p{margin-top:1rem;max-width:34em;font-size:1rem;line-height:1.7}
.card__foot{margin-top:auto;padding-top:clamp(20px,2.4vw,30px)}
.card__icon{width:auto;height:1cap;border-radius:24%;flex:none}
/* Whole iOS icons are 12% taller than the visible glyphs for optical balance. */
.card--compact .card__icon{height:calc(.667em * 1.12)}
.card--yifan .card__icon{height:calc(.934em * 1.12)}
.card--featured .card__icon{border-radius:0}
.card--keyhop .card__icon{height:1.286cap;margin-block:-.143cap}
.card--yiyan .card__icon{height:1.647cap;margin-block-start:-.647cap}
.card__go{
  display:inline-flex;min-height:44px;align-items:center;gap:.75rem;
  padding:.75rem .875rem .75rem 1rem;border-radius:999px;
  background:color-mix(in oklch,currentColor 7%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 12%,transparent);
  font:600 .9375rem/1 var(--sans);
}
.card__go::after{content:"";position:absolute;z-index:2;inset:0}
.card__go>*{position:relative;z-index:3}
.card__go:focus-visible{outline:none}
.card:has(.card__go:focus-visible){outline:2px solid var(--accent);outline-offset:4px}
.card__arrow{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;background:color-mix(in oklch,currentColor 9%,transparent)}
.card__shots{
  display:grid;min-width:0;overflow:hidden;place-items:center;padding:clamp(12px,1.5vw,20px);
  border-radius:calc(var(--r-card) - 6px);
  background:color-mix(in oklch,currentColor 6%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in oklch,currentColor 9%,transparent);
}
.card__shots img{
  width:100%;height:100%;max-height:clamp(190px,22vw,320px);object-fit:cover;object-position:top;
  border-radius:min(1.2vw,8px);outline:1px solid color-mix(in oklch,currentColor 10%,transparent);outline-offset:-1px;
}
:is(.card--keyhop,.card--yiyan) .card__shots{aspect-ratio:auto}
:is(.card--keyhop,.card--yiyan) .card__shots img{height:auto;max-height:none;object-fit:contain;outline:none}
@media (hover:hover) and (pointer:fine){
  .card:has(.card__go:hover){z-index:4;transform:translateY(-6px) rotate(0)}
  .card:has(.card__go:active){transform:translateY(-2px) rotate(0) scale(.995)}
  .card:has(.card__go:hover) .card__go{background:color-mix(in oklch,currentColor 11%,transparent)}
}
@media (max-width:720px){
  .deck>[data-reveal-group]{grid-template-columns:minmax(0,1fr);gap:16px}
  .card--featured{grid-column:auto}
  .card__grid{grid-template-columns:minmax(0,1fr)}
  .card__shots{aspect-ratio:16/9}
}
@media (max-width:560px){
  .card{border-radius:14px;padding:20px;transform:none}
  .card__tag{font-size:.6875rem}
  .card__grid,.card--compact .card__grid{padding-top:20px}
  .card__heading{font-size:36px}
  .card--compact .card__heading{font-size:32px}
  .card__p{font-size:1.0625rem;line-height:1.65}
  .card__foot{width:100%;padding-top:20px}
  .card__go{width:100%;min-height:48px;justify-content:space-between}
  .card__shots{padding:10px;border-radius:10px}
}
@media (max-width:360px){
  .card__heading{font-size:34px}
  .card--compact .card__heading{font-size:30px}
}
</style>
</head>

<body>


<div class="grain" data-grain-animate="true"></div>


<div data-load-wrap class="loader" id="loader" aria-hidden="true">
  <div data-load-bg class="loader__bg">
    <div data-load-progress class="loader__bg-bar"></div>
  </div>
  <div data-load-container class="loader__container">
    <div class="loader__logo-wrap">
      <div class="loader__logo-item is--base">
        <span class="loader__logo-img" lang="en">LAZYAPPS</span>
      </div>
      <div data-load-logo class="loader__logo-item is--top">
        <span class="loader__logo-img" lang="en">LAZYAPPS</span>
      </div>
    </div>
    <div class="loader__text-wrap">
      <span data-load-text data-load-reset class="loader__text-el" lang="en">Independent software</span>
      <span data-load-text data-load-reset class="loader__text-el" lang="en">Since 2009</span>
    </div>
  </div>
</div>

<main>

  
  <section class="hero wrap">
    <h1 class="hero__brand dsp">
      <span class="wordmark">lazyapps<i aria-hidden="true"></i></span>
    </h1>

    <div data-reveal-group data-stagger="110" data-distance="1.2em" data-start="top 92%">
      <p class="hero__sub">Small, focused tools for Mac, iPhone, and iPad. Local-first, free of tracking, and crafted for daily use.</p>
    </div>

  </section>

  
  <section class="deck wrap" id="deck">
    <div data-reveal-group data-stagger="140" data-distance="2.1em" data-start="top 88%">

      <article class="card card--featured card--keyhop" id="keyhop">
        <p class="card__tag">macOS 26+ · Apple silicon</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={keyhopIconUrl} alt="">
              <h3 class="card__title dsp">KeyHop</h3>
            </div>
            <p class="card__p">Ten fixed home-row keys map to ten apps. Switch or launch with pure muscle memory—regardless of keyboard layout.</p>
            <div class="card__foot">
              <a data-hover href="/keyhop/" class="card__go"><span>Explore KeyHop</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="card__shots">
            <img src={keyhopSettingsUrl} alt="KeyHop settings with leader-key selection and home-row app assignments" width="1944" height="1408">
          </div>
        </div>
      </article>

      <article class="card card--featured card--yiyan" id="yiyan">
        <p class="card__tag">macOS 15+ · English learning</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={yiyanIconUrl} alt="">
              <h3 class="card__title dsp">YiYan</h3>
            </div>
            <p class="card__p">Captures what you write in Pi, Claude Code, Codex, OpenCode, or Antigravity and returns natural English with focused notes—with in-place text polishing whenever you need it.</p>
            <div class="card__foot">
              <a data-hover href="/yiyan/" class="card__go"><span>Explore YiYan</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="card__shots">
            <img src={showcaseUrl} alt="YiYan learning log on macOS" width="1616" height="1388">
          </div>
        </div>
      </article>

      <article class="card card--featured card--xvdl">
        <p class="card__tag">macOS · Safari extension</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={xvdlIconUrl} alt="">
              <h3 class="card__title dsp">XVDL</h3>
            </div>
            <p class="card__p">Adds a download button to X videos and saves the highest-quality available MP4 straight to Downloads in Safari.</p>
            <div class="card__foot">
              <a data-hover href="/xvdl/" class="card__go"><span>Explore XVDL</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="card__shots">
            <img src={inUseUrl} alt="XVDL download button on an X video post">
          </div>
        </div>
      </article>

      <article class="card card--compact card--chmate">
        <p class="card__tag">iPhone &amp; iPad · Since 2009</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={appChmateUrl} alt="">
              <h3 class="card__title dsp">CHMate+</h3>
            </div>
            <p class="card__p">Keep EPUB and CHM documents organized and ready to read on iPhone and iPad.</p>
            <div class="card__foot">
              <a data-hover href="https://apps.apple.com/us/app/chmate-epub-chm-reader/id324516521?uo=4" class="card__go"><span>View on App Store</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--cia">
        <p class="card__tag">iPhone &amp; iPad · Since 2011</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={appCiaUrl} alt="">
              <h3 class="card__title dsp">The CIA World Factbook</h3>
            </div>
            <p class="card__p">Explore country profiles, maps, flags, and reference data—fully offline.</p>
            <div class="card__foot">
              <a data-hover href="https://apps.apple.com/us/app/the-cia-world-factbook/id412637620?uo=4" class="card__go"><span>View on App Store</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--yifan">
        <p class="card__tag">iPhone &amp; iPad · Since 2012</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={appYifanUrl} alt="">
              <h3 class="card__title dsp"><span class="zh" lang="zh">一饭</span></h3>
            </div>
            <p class="card__p">A native Fanfou client for timelines, mentions, direct messages, favorites, and photos.</p>
            <div class="card__foot">
              <a data-hover href="https://apps.apple.com/us/app/%E4%B8%80%E9%A5%AD-%E5%B2%81%E9%9D%99%E9%A5%AD%E5%90%A6%E5%AE%A2%E6%88%B7%E7%AB%AF/id541110403?uo=4" class="card__go"><span>View on App Store</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

      <article class="card card--compact card--fondfont">
        <p class="card__tag">iPhone &amp; iPad · Since 2014</p>
        <div class="card__grid">
          <div class="card__copy">
            <div class="card__heading">
              <img class="card__icon" src={appFondfontUrl} alt="">
              <h3 class="card__title dsp">FondFont</h3>
            </div>
            <p class="card__p">Install custom TTF, TTC, and OTF fonts for use in iPhone and iPad apps.</p>
            <div class="card__foot">
              <a data-hover href="https://apps.apple.com/us/app/fondfont-install-system-fonts/id842109099?uo=4" class="card__go"><span>View on App Store</span><span class="card__arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </article>

    </div>
  </section>

</main>

<footer class="wrap">

  
  <section class="qa">
    <div>
      <p class="qa__q">Who makes this?</p>
      <p class="qa__a">One independent developer. Focused tools for Mac, iPhone, and iPad, crafted and maintained by lazyapps since 2009.</p>
    </div>
    <div>
      <p class="qa__q">What do you collect?</p>
      <p class="qa__a">Nothing. No analytics, no tracking, and no lazyapps servers storing your personal data. Some optional features use services you choose, such as iCloud. <a data-hover href="/privacy.en.html"><span data-underline-link class="underline-link">Privacy</span></a></p>
    </div>
    <div>
      <p class="qa__q">Where do I get them?</p>
      <p class="qa__a">The App Store for iPhone and iPad. Homebrew and direct downloads for Mac apps—<a data-hover href="/keyhop/"><span data-underline-link class="underline-link">KeyHop</span></a>, <a data-hover href="/xvdl/"><span data-underline-link class="underline-link">XVDL</span></a>, and <a data-hover href="/yiyan/"><span data-underline-link class="underline-link">YiYan</span></a>.</p>
    </div>
  </section>

  
  <SiteFooterBase />

</footer>

<script is:inline src={gsapUrl}>

</script>
<script is:inline src={scrollTriggerUrl}>

</script>
<script is:inline src={customEaseUrl}>

</script>
<script is:inline src={splitTextUrl}>

</script>

<script is:inline src={logoRevealUrl}>

</script>
<script is:inline src={siteJsUrl}>

</script>

</body>
</html>
